{
  peppy_schema: "contract/v1",
  manifest: {
    name: "locations",
    tag: "v1",
    description: [
      "The locations a skill knows: the named places of a work cell, or of the world in simulation, that a workflow names with `{ $location }` in a field with the mark `location`.",
      "A node with such a field implements this contract. teach replaces the locations the node knows with the ones given, and list gives them. The applier of worlds teaches the locations of a world to each robot of the world after it builds the world, and the workflow director lists them before a run and refuses a run that names a location the skill of its role does not know. People and programs teach through the locations member of the director, which refuses a teach on a robot with a lease, or through this contract with `peppy node call`, which no lease guards: teach has no mark `moves_robot`, and a provider reads no lease.",
      "Each location names its frame and holds at every time, so its record holds no timestamp: its frame is world in a simulation, or a frame of its robot's tree as transforms names frames, such as map. A location that teach takes with no frame lies in the robot frame. Its position is the position of the pose or the landmark, or the center of the surface or of the region, and its orientation gives the axes of the location: z is the normal of a landmark or a surface (up), x runs along the axis of a landmark or the first edge of a surface, and y completes the right hand. The node maps a location in world into its own frame from the stand of its robot, and places one in a frame of its robot's tree by its tree at the latest time, each time it uses the location.",
    ],
  },
  failure_kinds: {
    unknown_frame: "A frame of the request is named by no transform the implementer has received that passed the checks of transforms",
    no_chain: "A frame of the request and the frame the implementer places it in are in trees that share no frame",
    extrapolation: "A moving transform on the chain has no value at the request's time: the implementer holds no stamp of it, or the time is before the oldest stamp it holds of it or after its newest",
    broken_tree: "A frame whose transform to its parent the chain needs has transforms from two publishers, or the chain runs through a cycle",
  },
  interfaces: {
    services: [
      {
        name: "teach",
        description: "Replaces the known locations with `locations`, and gives the known locations after the call, as list does. Refused with rejected, and the known locations stay, for a name that is not a name of `locations` of workflow/v1 (a lowercase letter first, then lowercase letters, digits and `_`, at most 64 characters, and not a word of CEL such as `in` or `true`), a name given twice, an orientation whose squared norm lies 0.01 or more from 1, or a size with a negative entry; the node normalizes each orientation it takes. A location in a frame other than world that the node cannot place in its robot frame by its tree, at the latest time, is refused with the failure kind of the lookup, its message naming the location and the cause as transform_lookup's does, and the known locations stay.",
        request_message_format: {
          locations: {
            $type: "array",
            $items: {
              $type: "object",
              name: "string",
              kind: { $type: "string", $enum: ["pose", "landmark", "surface", "region"], $description: "What the location is: a pose, the landmark of an object, a level surface or a region of space." },
              frame: { $type: "string", $optional: true, $description: "The frame of the record's values, as transforms names frames; absent, the robot frame." },
              position: { $type: "array", $items: "f64", $length: 3, $description: "x, y, z (m)." },
              orientation: { $type: "array", $items: "f64", $length: 4, $description: "A unit quaternion [x, y, z, w]." },
              size: { $type: "array", $items: "f64", $length: 3, $description: "The extent of the location in meters, size[0] along its x: a surface's along its x and y (0 along z), a region's along its own axes, a landmark's along its axis and across it as get_object of scene_manipulation gives it (0 along z), and zero for a pose." },
            },
          },
        },
        response_message_format: {
          locations: {
            $type: "array",
            $items: {
              $type: "object",
              name: "string",
              kind: { $type: "string", $enum: ["pose", "landmark", "surface", "region"] },
              frame: { $type: "string", $description: "The frame of the record's values, as transforms names frames." },
              position: { $type: "array", $items: "f64", $length: 3, $description: "x, y, z (m)." },
              orientation: { $type: "array", $items: "f64", $length: 4, $description: "A unit quaternion [x, y, z, w]." },
              size: { $type: "array", $items: "f64", $length: 3 },
            },
          },
        },
        failure_kinds: ["unknown_frame", "no_chain", "extrapolation", "broken_tree"],
      },
      {
        name: "list",
        description: "The known locations, in the order of the last teach; none before the first teach.",
        response_message_format: {
          locations: {
            $type: "array",
            $items: {
              $type: "object",
              name: "string",
              kind: { $type: "string", $enum: ["pose", "landmark", "surface", "region"] },
              frame: { $type: "string", $description: "The frame of the record's values, as transforms names frames." },
              position: { $type: "array", $items: "f64", $length: 3, $description: "x, y, z (m)." },
              orientation: { $type: "array", $items: "f64", $length: 4, $description: "A unit quaternion [x, y, z, w]." },
              size: { $type: "array", $items: "f64", $length: 3 },
            },
          },
        },
      },
    ],
  },
}
