Bootstrap: docker
From: peppybot/rust-cargo-base:latest

%labels
    Name workflow_director
    Version v1

%files
    . /opt/workflow_director

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    cd /opt/workflow_director
    cargo build --release

%runscript
    cd /opt/workflow_director
    exec ./target/release/workflow_director
