// What this engine alone knows about an OpenArm v2. Its limbs, joints and
// cameras come from the robot's description, through sim_robot_core's entry of
// the same name.
{
  // The robot's USD, under PEPPY_ROBOT_ASSETS_DIR. The engine references it
  // under a prim of the robot's own name, so the stage's default prim is the
  // robot's prim.
  stage: "openarm/openarm_bimanual_v2.usd",

  // The stage's default prim carries the articulation root, and every link is
  // a prim named after its URDF link under it, which is where a camera
  // hanging from that link is defined. Joint prims are named after the joints
  // of the shared entry, which is how PhysX names their dofs.
  articulation_root: ".",

  // MIT servo gains (j1..j7) applied to every arm's PhysX joint drives: the
  // real arm's, the defaults of openarm/arm/peppy.json5, which
  // tests/test_isaac_models.py holds them to. Each drive is capped at the
  // effort limit the description gives its joint, its motor's peak torque.
  arm_gains: {
    kp: [360.0, 360.0, 360.0, 360.0, 48.0, 62.0, 50.0],
    kd: [5.0, 5.0, 5.0, 5.0, 1.5, 1.5, 1.5],
  },

  // Explicit PhysX finger drive, one per finger of a gripper that moves of
  // its own: the other finger follows it through the mimic coupling the
  // description gives, one motor for the pair. Without it the fingers can
  // free-float when the arm moves if the imported USD has weak/default drive
  // gains. The drive is capped at the effort limit the description gives its
  // joint.
  gripper_gains: {
    kp: [80.0],
    kd: [2.0],
  },

  // Mirrors the real driver's in-process gravity feedforward by disabling
  // gravity on the robot's links.
  gravity_compensation: true,

  // The robot draws the head camera pack on its pedestal (head_camera.py),
  // whose left eye its chest camera renders from.
  head_camera: true,
}
