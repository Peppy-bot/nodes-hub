// Captures what the robot actually did, for later training.
//
// Taps the executor side of the `task_delegation` pairing WITHOUT joining it.
// An observer slot claims no slot on the source and holds no peer, so this node
// cannot perturb control no matter how it behaves: the worst it can do to the
// robot is fall behind.
//
// It observes across a daemon boundary here, which changes nothing about how it
// is written. What differs is invisible from this side: the source's lifecycle
// transitions reach this node's daemon as notifications from the source's own
// daemon rather than from local lifecycle events, so a source restart still
// makes this node drop and redeclare its subscription.
{
  peppy_schema: "node/v1",
  manifest: {
    name: "episode_recorder",
    tag: "v1",
    labels: ["recorder"],
    depends_on: {
      pairings: [
        // `observes_role` rather than `role`: this is an observer slot, not a
        // participant one. It names the ROLE it watches, and the launcher names
        // the instance.
        {
          name: "task_delegation",
          tag: "v1",
          observes_role: "executor",
          link_id: "observed_execution",
        },
      ],
    },
  },
  interfaces: {
    topics: {
      consumes: [
        // Only the observed role's emissions are readable, and only for
        // reading: an observer has no `emits` block for this link.
        { link_id: "observed_execution", name: "situation" },
      ],
    },
  },
  execution: {
    language: "python",
    build_cmd: ["uv", "sync", "--no-editable"],
    run_cmd: ["./.venv/bin/python", "-m", "episode_recorder"],
  },
}
