// The large vision-language-action / world model. Proprietary weights,
// multi-second horizon, roughly 1 Hz.
//
// This node wants a datacenter accelerator no mobile platform carries, and at
// its own cycle time a WAN round trip is a small fraction of a plan step, so
// latency is close to free for it. That is the reason the split exists.
//
// Never a `local:` source in a launcher: the path would name a tree on the
// robot's filesystem, and peppy refuses `local:` for any deployment placed
// off-coordinator.
{
  peppy_schema: "node/v1",
  manifest: {
    name: "deliberative_planner",
    tag: "v1",
    labels: ["planner"],
    depends_on: {
      contracts: [
        // The SAME camera instance the reactive policy reads locally, named
        // exactly the same way. Placement is declared once on the instance and
        // never repeated at the point of use, so nothing here records that this
        // producer is on another machine.
        { name: "rgb_camera", tag: "v1", link_id: "scene" },
      ],
      pairings: [
        // The slow side of the conversation: this node advises.
        { name: "task_delegation", tag: "v1", role: "deliberator", link_id: "deliberation" },
      ],
    },
  },
  interfaces: {
    topics: {
      consumes: [
        { link_id: "scene", name: "video_stream" },
        { link_id: "deliberation", name: "situation" },
      ],
      emits: [
        { link_id: "deliberation", name: "subgoal" },
      ],
    },
  },
  execution: {
    language: "python",
    parameters: {
      // Plan rate. Two orders of magnitude below the executor's control rate,
      // which is what makes the split viable.
      plan_rate_hz: "u32",
      // How far ahead this node plans, in seconds.
      horizon_s: "u32",
    },
    build_cmd: ["uv", "sync", "--no-editable"],
    run_cmd: ["./.venv/bin/python", "-m", "deliberative_planner"],
  },
}
