{
  peppy_schema: "node/v1",
  manifest: {
    name: "uvc_camera_video_reconstruction_python",
    tag: "v1",
    description: [
      "A recorder that writes video_duration_seconds of the video stream of a camera that implements rgb_camera:v1 into an H.264 MP4 file, /tmp/video_reconstruction/reconstructed_video.mp4 on its host. It needs such a camera, real or mock; it opens no device itself.",
      "It reads each frame as rgb8 and encodes it as it arrives. A stop before the end closes the file with the frames recorded up to then. At the end, the node stops itself. uvc_camera_video_reconstruction_rust records the same file in Rust.",
    ],
    depends_on: {
      contracts: [
        {
          name: "rgb_camera",
          tag: "v1",
          link_id: "camera"
        },
      ]
    }
  },
  execution: {
    language: "python",
    container: {
      def_file: "apptainer.def",
      mount_paths: [
        // host_path:container_path:options
        "/tmp/video_reconstruction:/tmp/video_reconstruction:rw"
      ]
    },
    parameters: {
      // How long do you want the reconstruction to be?
      video_duration_seconds: "u32"
    }
  },
  interfaces: {
    topics: {
      consumes: [
        {
          link_id: "camera",
          name: "video_stream",
        },
      ],
    },
    services: {
      consumes: [
        {
          link_id: "camera",
          name: "video_stream_info",
        },
      ]
    }
  }
}