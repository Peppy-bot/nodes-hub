Bootstrap: docker
From: tuatini/peppy-python-uv-base:latest

%labels
    Name uvc_camera_video_reconstruction_python
    Version 0.1.0

%environment
    export PATH="/opt/uvc_camera_video_reconstruction_python/.venv/bin:$PATH"

%files
    . /opt/uvc_camera_video_reconstruction_python

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    # Keep the interpreter out of the container user's home directory. uv
    # installs managed Pythons under $HOME, so this one would land in /root
    # inside the image. At run time apptainer mounts the home of the user
    # running the daemon over the image's own home, taken from the image's
    # /etc/passwd and so /root for uid 0, which covers whatever the build left
    # there. A daemon running as root is left with a venv whose `python` points
    # into a buried path, and the node dies at exec with
    # `./.venv/bin/python: not found`.
    export UV_PYTHON_INSTALL_DIR=/opt/uv-python

    cd /opt/uvc_camera_video_reconstruction_python
    uv python install
    uv sync --no-editable

%runscript
    cd /opt/uvc_camera_video_reconstruction_python
    exec ./.venv/bin/python -m uvc_camera_video_reconstruction_python
