// sim_rgb_camera: the sim color camera, a relay between the simulation's
// sim_rgb_camera_link pairing and the rgb_camera contract surface. Toward
// consumers it is a camera exactly like the real uvc nodes (frames out,
// stream info and control services answered) that also describes itself
// through camera_profile; toward the simulation it views a pair of the
// simulation's colour camera slot and, when a launch links its control slot
// to the simulation, forwards every camera control there under the camera's
// name, so the simulation's device model answers them. Without that link
// every control refuses. Frames relay timestamps and frame_ids untouched, so
// consumers age samples on the capture time. One instance per camera, and
// the camera's name is the instance's own in its copy: relay
// alpha_wrist_left of copy alpha is camera wrist_left, and a relay launched
// outside a copy is the camera its instance id names.
{
  peppy_schema: "node/v1",
  manifest: {
    name: "sim_rgb_camera",
    tag: "v1",
    implements: [
      { name: "rgb_camera", tag: "v1", link_id: "camera" },
      { name: "camera_profile", tag: "v1", link_id: "profile" },
    ],
    depends_on: {
      pairings: [
        // The simulation's colour camera slot, which holds a pair per
        // camera: this relay views, the simulation streams the camera this
        // relay's name says. Required: a relay without a simulation is a
        // misconfiguration, so the launch fails loudly instead.
        { name: "sim_rgb_camera_link", tag: "v1", role: "viewer", link_id: "simulation" },
      ],
      contracts: [
        // The simulation's camera response model, when it has one: the
        // controls a consumer sets on this camera go there, under this
        // relay's name in its copy. A launch on a simulation without one
        // writes the slot vacant, and every control refuses.
        { name: "sim_camera_control", tag: "v1", link_id: "control", cardinality: "zero_or_one" },
      ],
    },
  },
  interfaces: {
    topics: {
      emits: [
        { link_id: "camera", name: "video_stream" },
      ],
      consumes: [
        { link_id: "simulation", name: "video_stream" },
        { link_id: "simulation", name: "stream_info" },
      ],
    },
    services: {
      exposes: [
        { link_id: "camera", name: "video_stream_info" },
        { link_id: "camera", name: "set_exposure" },
        { link_id: "camera", name: "set_white_balance" },
        { link_id: "camera", name: "set_gain" },
        { link_id: "camera", name: "set_brightness" },
        { link_id: "camera", name: "set_contrast" },
        { link_id: "profile", name: "get_camera_profile" },
        { link_id: "profile", name: "reset_camera" },
      ],
      consumes: [
        { link_id: "control", name: "describe_camera" },
        { link_id: "control", name: "set_camera_exposure" },
        { link_id: "control", name: "set_camera_white_balance" },
        { link_id: "control", name: "set_camera_gain" },
        { link_id: "control", name: "set_camera_brightness" },
        { link_id: "control", name: "set_camera_contrast" },
        { link_id: "control", name: "reset_camera" },
      ],
    },
  },
  execution: {
    language: "rust",
    container: {
      def_file: "apptainer.def",
    },
    parameters: {},
  },
}
