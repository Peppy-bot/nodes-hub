// sim_rgb_camera: the sim color camera, a relay between the engine's
// sim_rgb_camera_link pairing and the rgb_camera contract surface. Toward consumers it
// is a camera exactly like the real uvc nodes (frames out, stream info and
// control services answered); toward the sim engine it views the matching
// camera slot. Frames relay timestamps and frame_ids untouched, so consumers age
// samples on the capture time. One instance per camera; the engine slot
// carries the camera's identity, so there is no id anywhere.
{
  peppy_schema: "node/v1",
  manifest: {
    name: "sim_rgb_camera",
    tag: "v1",
    implements: [
      { name: "rgb_camera", tag: "v1", link_id: "camera" },
    ],
    depends_on: {
      pairings: [
        // The engine's matching camera slot: this relay views, the engine
        // streams. Required: a relay without an engine is a misconfiguration,
        // so the launch fails loudly instead.
        { name: "sim_rgb_camera_link", tag: "v1", role: "viewer", link_id: "engine" },
      ],
    },
  },
  interfaces: {
    topics: {
      emits: [
        { link_id: "camera", name: "video_stream" },
      ],
      consumes: [
        { link_id: "engine", name: "video_stream" },
        { link_id: "engine", name: "stream_info" },
      ],
    },
    services: {
      exposes: [
        { link_id: "camera", name: "video_stream_info" },
        { link_id: "camera", name: "set_exposure" },
        { link_id: "camera", name: "set_white_balance" },
        { link_id: "camera", name: "set_gain" },
        { link_id: "camera", name: "set_brightness" },
        { link_id: "camera", name: "set_contrast" },
      ],
    },
  },
  execution: {
    language: "rust",
    container: {
      def_file: "apptainer.def",
    },
    parameters: {},
  },
}
