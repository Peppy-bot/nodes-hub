// realsense_d4xx wraps librealsense2 via realsense-rust. Consumers (and
// sim/mock RGB-D nodes) bind against the rgbd_camera contract rather than
// this concrete node. For the stereo IR pair or the IMU streams, add a node
// implementing an additional contract if a consumer needs them.
{
  peppy_schema: "node/v1",
  manifest: {
    name: "realsense_d4xx",
    tag: "v1",
    description: [
      "An Intel RealSense D4xx RGB-D camera (D405, D435, D435i, D455 and others): it publishes synchronized colour and depth streams with a shared frame_id. It needs a RealSense D4xx device on its host.",
      "It implements rgbd_camera and camera_geometry. camera_geometry answers from the calibration of the device, read from librealsense at startup, for the streams as the current align mode publishes them: unaligned, each stream has its own pinhole model and the depth-to-colour transform is that of the device; aligned, both streams share the model of the target stream and the transform is the identity. The stereo IR pair that gives the depth and the IMU streams (D435i, D455) are not published.",
    ],
    implements: [
      { name: "rgbd_camera", tag: "v1", link_id: "camera" },
      { name: "camera_geometry", tag: "v1", link_id: "geometry" },
    ],
    labels: [
      "realsense",
      "rgbd",
      "camera",
    ]
  },
  execution: {
    language: "rust",
    container: {
      def_file: "apptainer.def"
    },
    parameters: {
      // Device serial (visible via `rs-enumerate-devices`). Optional ($default
      // ""): empty binds the first device librealsense reports. Set it
      // explicitly on multi-camera robots, where first-device is non-deterministic.
      serial:       { $type: "string", $default: "" },
      // Color stream config. Depth is always Z16. Pixel format is one of:
      //   "rgb8" (universal, tensor-friendly), "bgr8" (OpenCV order),
      //   "yuyv" (33% wire savings), "mjpeg" (~10:1 compression, JPEG-encoded).
      // librealsense2 validates the (width, height, fps, format) tuple at
      // pipeline start against the connected device's reported profiles.
      color_width:  { $type: "u32" },
      color_height: { $type: "u32" },
      color_fps:    { $type: "u32" },
      color_format: { $type: "string" },
      depth_width:  { $type: "u32" },
      depth_height: { $type: "u32" },
      depth_fps:    { $type: "u32" },
      // The align mode the node starts in: "none", "depth_to_color" or
      // "color_to_depth"; set_align_mode changes it while running. A robot
      // whose consumers expect depth in the colour image, as the ZED gives
      // it, launches with "depth_to_color".
      align_mode:   { $type: "string", $default: "none" }
    }
  },
  interfaces: {
    topics: {
      emits: [
        { link_id: "camera", name: "video_stream" },
        { link_id: "camera", name: "depth_stream" },
      ],
    },
    services: {
      exposes: [
        { link_id: "camera", name: "video_stream_info" },
        { link_id: "camera", name: "depth_stream_info" },
        { link_id: "camera", name: "set_color_exposure" },
        { link_id: "camera", name: "set_color_white_balance" },
        { link_id: "camera", name: "set_color_gain" },
        { link_id: "camera", name: "set_color_brightness" },
        { link_id: "camera", name: "set_color_contrast" },
        { link_id: "geometry", name: "get_color_intrinsics" },
        { link_id: "geometry", name: "get_depth_intrinsics" },
        { link_id: "geometry", name: "get_depth_to_color_extrinsics" },
        // RealSense-specific hardware knobs, native to this node (the
        // rgbd_camera contract carries only what every device can honor).
        {
          name: "set_depth_gain",
          description: "Set the gain of the depth imager, a device option. The reply gives the value that the node wrote. A write gets an error reply with `rejected` when the device does not offer the option or does not take the value, with `resource_unavailable` when the device is disconnected, and with `attempt_failed` when it fails for another reason.",
          request_message_format: { value: "i32" },
          response_message_format: {
            current_value: "i32",
          },
        },
        {
          name: "set_depth_laser_power_mw",
          description: "Set the power of the IR projector, in mW, a device option: 0 disables the projector. The reply gives the value that the node wrote. A write gets an error reply with `rejected` when the device does not offer the option or does not take the value, with `resource_unavailable` when the device is disconnected, and with `attempt_failed` when it fails for another reason.",
          request_message_format: { value: "i32" },
          response_message_format: {
            current_value: "i32",
          },
        },
        {
          name: "set_align_mode",
          description: "Set the spatial alignment between the streams: \"none\" emits raw sensor frames; \"depth_to_color\" warps depth into color's viewpoint and resolution; \"color_to_depth\" is the inverse. The reply gives the mode that the node applies from then on. An unknown mode gets an error reply with `rejected`.",
          request_message_format: {
            mode: "string",
          },
          response_message_format: {
            current_mode: "string",
          },
        },
      ],
    },
  }
}
