Bootstrap: docker
From: peppybot/rust-cargo-base:latest

%labels
    Name transform_server
    Version v1

%files
    . /opt/transform_server

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    cd /opt/transform_server
    cargo build --release

%runscript
    cd /opt/transform_server
    exec ./target/release/transform_server
