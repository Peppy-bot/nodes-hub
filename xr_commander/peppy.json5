// xr_commander: a robot-agnostic teleoperation leader driven from a WebXR
// headset. Serves the WebXR page (teleop_xr), streams a Cartesian setpoint per
// hand on pose_link and an opening per hand on gripper_link to the robot it
// drives, relays bound cameras into the headset as WebRTC tracks, and
// publishes where its page is: the page's URLs. One headset per
// stack: the backbone of every robot it leads pairs into its slots, and the
// robot card on its page chooses the one the hands drive, else the robot
// they drive while it stays paired, else the first robot paired. Carries no
// kinematics: solving a pose into joints is the follower's business. The
// deadman is the grip button, per hand; released streams the measured pose
// for a quarter second, then nothing, and the follower holds.
{
  peppy_schema: "node/v1",
  manifest: {
    name: "xr_commander",
    tag: "v1",
    labels: [
      "teleop",
      "xr",
      "webxr",
      "commander",
    ],
    implements: [
      // Where the headset's page is, for whoever is not wearing it: the
      // URLs its page is served at.
      { name: "headset", tag: "v1", link_id: "headset" },
    ],
    depends_on: {
      contracts: [
        // Optional dataset recorder, driven from the headset: the face
        // buttons start and stop episodes and finish the session, so an
        // operator records without taking the headset off.
        { name: "episode_recording", tag: "v1", link_id: "recorder", cardinality: "zero_or_more" },
        // Operator video; depth of an RGB-D camera is not consumed.
        { name: "rgb_camera", tag: "v1", link_id: "color_cameras", cardinality: "zero_or_more" },
        { name: "rgbd_camera", tag: "v1", link_id: "rgbd_cameras", cardinality: "zero_or_more" },
        // Whole-robot posture moves.
        { name: "postures", tag: "v1", link_id: "postures", cardinality: "zero_or_more" },
        // Operator alerts from any producer the launcher wires, listed on
        // the status panel: the headset has no text channel of its own.
        // Unbound, the panel draws no alert section.
        { name: "alert", tag: "v1", link_id: "alerts", cardinality: "zero_or_more" },
        // Per-motor health from any motor-bearing producer the launcher
        // wires, listed on the status panel. Unbound, the panel draws no
        // health section.
        { name: "motor_health", tag: "v1", link_id: "motor_health", cardinality: "zero_or_more" },
        // The sensor streams of a simulation, where one runs: the headset
        // holds the sensors of the chosen robot, so that its cameras stream
        // at their own rate while the operator drives it, and releases them
        // when it chooses another robot or stops. Unbound (a physical
        // stack), the headset holds nothing.
        { name: "sim_sensor_streams", tag: "v1", link_id: "sensor_streams", cardinality: "zero_or_one" },
      ],
      pairings: [
        // One Cartesian command loop per operator hand. Every robot the
        // launcher pairs in holds a pair here; the hand drives the pair of
        // the chosen robot and is silent toward the others.
        { name: "pose_link", tag: "v1", role: "leader", link_id: "left_arm", cardinality: "zero_or_more" },
        { name: "pose_link", tag: "v1", role: "leader", link_id: "right_arm", cardinality: "zero_or_more" },
        // The same hand's opening loop.
        { name: "gripper_link", tag: "v1", role: "leader", link_id: "left_gripper", cardinality: "zero_or_more" },
        { name: "gripper_link", tag: "v1", role: "leader", link_id: "right_gripper", cardinality: "zero_or_more" },
      ],
    },
  },
  interfaces: {
    topics: {
      emits: [
        { link_id: "headset", name: "page" },
        { link_id: "left_arm", name: "pose_setpoints" },
        { link_id: "right_arm", name: "pose_setpoints" },
        { link_id: "left_gripper", name: "gripper_setpoints" },
        { link_id: "right_gripper", name: "gripper_setpoints" },
      ],
      consumes: [
        // Measured end-effector pose.
        { link_id: "left_arm", name: "pose_states" },
        { link_id: "right_arm", name: "pose_states" },
        { link_id: "color_cameras", name: "video_stream" },
        { link_id: "rgbd_cameras", name: "video_stream" },
        { link_id: "alerts", name: "alerts" },
        { link_id: "motor_health", name: "motor_health" },
      ],
    },
    services: {
      consumes: [
        // Finalizes the current dataset session and opens a fresh one.
        { link_id: "recorder", name: "finish_session" },
        // Holds, renews and releases the sensors of the chosen robot.
        { link_id: "sensor_streams", name: "hold" },
        { link_id: "sensor_streams", name: "release" },
      ],
    },
    actions: {
      consumes: [
        { link_id: "postures", name: "move_to_ready" },
        { link_id: "postures", name: "move_to_home" },
        // One dataset episode per goal; cancelling stops and saves it.
        { link_id: "recorder", name: "record_episode" },
      ],
    },
  },
  execution: {
    language: "python",
    container: {
      def_file: "apptainer.def",
    },
    // The socket the WebXR server binds during setup. The label is announced
    // with the address the server took; the daemon reports the URLs.
    endpoints: {
      page: { kind: "page", description: "The WebXR page, HTTPS with the node's self-signed certificate." },
    },
    parameters: {
      // Rate (Hz, 1..=1000) the per-hand setpoint streams publish at while
      // engaged.
      command_rate_hz: "u32",
      // Where the WebXR page is served (always TLS, self-generated cert).
      https_port: { $type: "u32", $default: 4443 },
      https_host: { $type: "string", $default: "0.0.0.0" },
      // Hand travel to end-effector travel. Orientation is never scaled.
      motion_scale: { $type: "f64", $default: 1.0 },
      // Opening commanded at a released trigger; a pull spans [0, this].
      gripper_open_fraction: { $type: "f64", $default: 1.0 },
      // Requested duration (s) of a posture move; 0 = fastest.
      posture_move_duration_s: { $type: "f64", $default: 2.0 },
      // Oldest headset frame or measured follower pose still trusted (s);
      // older input reads as absent.
      stale_timeout_s: { $type: "f64", $default: 0.25 },
      // Widest video frame (px) relayed into the headset; 0 relays
      // sensor-native frames.
      view_max_width: { $type: "u32", $default: 640 },
      // Draw a status panel in the headset (link, per-hand state, the
      // posture and recorder outcomes, alerts, motor health) as an extra
      // floating view above the cameras'; off, the headset shows cameras
      // only.
      status_panel_enabled: { $type: "bool", $default: true },
    },
  },
}
