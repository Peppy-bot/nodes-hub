Bootstrap: docker
From: peppybot/python-uv-base:latest

%labels
    Name xr_commander
    Version 0.1.0

%environment
    export PATH="/opt/xr_commander/.venv/bin:$PATH"

%files
    . /opt/xr_commander

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    # opencv-python links libGL and glib even when nothing is displayed; it is
    # pulled in by teleop-xr regardless of our own import of it.
    apt-get update && apt-get install -y --no-install-recommends \
        libgl1 libglib2.0-0 \
        && rm -rf /var/lib/apt/lists/*

    # Keep the managed interpreter out of $HOME: at run time apptainer mounts
    # the daemon user's home over the image's, burying the venv's python and
    # killing the node at exec. /opt survives the mount.
    export UV_PYTHON_INSTALL_DIR=/opt/uv-python

    cd /opt/xr_commander
    uv python install
    # --locked fails the build on a stale lockfile instead of re-resolving;
    # --no-dev keeps the test-only group out of the runtime image.
    uv sync --locked --no-editable --no-dev

%runscript
    cd /opt/xr_commander
    # -u: stdout to the daemon is a pipe, so buffered diagnostics would be lost
    # when the shutdown grace window force-kills the process.
    # 2>&1: the daemon drains only stdout; a full stderr pipe blocks the
    # event loop mid-write (uvicorn, aiortc, and teleop_xr all log there).
    exec ./.venv/bin/python -u -m xr_commander 2>&1
