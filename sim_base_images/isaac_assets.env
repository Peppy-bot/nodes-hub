# The SO-101's stage, built by sim_isaac/scripts/build_so101.py from the
# SO-101's MuJoCo model in the release of Waldo's catalogue that
# waldo_catalogue.py pins.
SO101_ASSETS_KEY="so101/4/e87dc7124a4439e4b72b741d8089c7ac18f9403569f90df10d63b1a1fd096eef.tar.gz"
SO101_ASSETS_SHA256="e87dc7124a4439e4b72b741d8089c7ac18f9403569f90df10d63b1a1fd096eef"
# The SHA-256 of the stage (so101.usd) that bundle holds. download_assets.sh
# refuses a bundle whose stage is another, and sim_isaac/tests/test_so101_stage.py
# holds the stage the tree builds to it.
SO101_STAGE_SHA256="3377734356ec30250c94e06f0ff5650d08cbeae6509773ef6854a1e3613fdeee"

# The botshare base's stage, built by sim_isaac/scripts/build_botshare_base.py
