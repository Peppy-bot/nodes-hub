FROM python:3.12-slim

RUN apt-get -o Acquire::Retries=5 -o Acquire::ForceIPv4=true update \
    && apt-get -o Acquire::Retries=5 -o Acquire::ForceIPv4=true install -y --no-install-recommends \
        ca-certificates \
        git \
        libgl1 \
        libgl1-mesa-dri \
        libglib2.0-0 \
        libgomp1 \
        libosmesa6 \
        libwayland-client0 \
        libwayland-cursor0 \
        libwayland-egl1 \
        libxkbcommon0 \
        libegl1 \
        libegl-mesa0 \
    && rm -rf /var/lib/apt/lists/*

# robot_description_py is a Rust extension that pip builds from its source:
# gcc and libc6-dev link it, and rustup's minimal profile under /opt/rust
# compiles it. The image keeps the built extension and no compiler.
COPY requirements.mujoco.txt /tmp/requirements.txt
RUN apt-get -o Acquire::Retries=5 -o Acquire::ForceIPv4=true update \
    && apt-get -o Acquire::Retries=5 -o Acquire::ForceIPv4=true install -y --no-install-recommends \
        curl gcc libc6-dev \
    && export RUSTUP_HOME=/opt/rust/rustup CARGO_HOME=/opt/rust/cargo CARGO_TARGET_DIR=/opt/rust/target \
    && curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs \
        | sh -s -- -y --no-modify-path --profile minimal --default-toolchain stable \
    && PATH="$CARGO_HOME/bin:$PATH" pip install --no-cache-dir --retries 5 --timeout 180 -r /tmp/requirements.txt \
    && rm -rf /opt/rust \
    && apt-get purge -y --auto-remove curl gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*

# Each robot's MuJoCo model, under /opt/robot_assets beside the release's
# robots.json, where the node's model entries look their files up: the
# release of Waldo's catalogue that waldo_catalogue.py pins, from the public
# store, each file checked against its digest.
COPY waldo_catalogue.py /tmp/waldo_catalogue.py
RUN python3 /tmp/waldo_catalogue.py fetch /opt/robot_assets \
    && rm /tmp/waldo_catalogue.py
