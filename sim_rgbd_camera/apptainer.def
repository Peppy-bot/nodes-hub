Bootstrap: docker
From: tuatini/peppy-rust-cargo-base:latest

%labels
    Name sim-rgbd-camera
    Version v1

%files
    . /opt/sim_rgbd_camera

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    cd /opt/sim_rgbd_camera
    cargo build --release

%runscript
    cd /opt/sim_rgbd_camera
    exec ./target/release/sim_rgbd_camera "$@"
