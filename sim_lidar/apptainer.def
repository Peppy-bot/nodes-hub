Bootstrap: docker
From: peppybot/rust-cargo-base:latest

%labels
    Name sim-lidar
    Version v1

%files
    . /opt/sim_lidar

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    cd /opt/sim_lidar
    cargo build --release

%runscript
    cd /opt/sim_lidar
    exec ./target/release/sim_lidar "$@"
