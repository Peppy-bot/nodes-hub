{
  peppy_schema: "node/v1",

  manifest: {
    name: "isaac_webviewer",
    tag: "v1",
  },

  execution: {
    language: "python",

    container: {
      def_file: "apptainer.def",
    },

    parameters: {
      // The port the viewer page is served on. One viewer per machine takes
      // the default; a second names a port of its own.
      http_port: { $type: "u16", $default: 8210 },
    },
  },
}
