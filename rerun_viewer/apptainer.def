Bootstrap: docker
From: peppybot/rust-cargo-base:latest

%labels
    Name rerun_viewer
    Version v1

%files
    . /opt/rerun_viewer

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    cd /opt/rerun_viewer
    cargo build --release

%runscript
    cd /opt/rerun_viewer
    exec ./target/release/rerun_viewer "$@"
