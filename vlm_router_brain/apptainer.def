Bootstrap: docker
From: peppybot/python-uv-base:latest

%labels
    Name vlm_router_brain
    Version v1

%environment
    export PATH="/opt/vlm_router_brain/.venv/bin:$PATH"

%files
    . /opt/vlm_router_brain

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    # uv resolves brain_core as a git dependency; the base image has no git.
    apt-get update -qq
    apt-get install -qqy --no-install-recommends git
    rm -rf /var/lib/apt/lists/*

    # Keep the interpreter out of the container user's home directory. uv
    # installs managed Pythons under $HOME, and at run time apptainer mounts
    # the daemon user's home over the image's own, hiding whatever the build
    # left there. A daemon running as root hides /root every time: the venv
    # builds fine and then dies at exec with `./.venv/bin/python: not found`.
    export UV_PYTHON_INSTALL_DIR=/opt/uv-python

    cd /opt/vlm_router_brain
    uv python install
    uv sync --no-editable --no-dev

%runscript
    cd /opt/vlm_router_brain
    exec ./.venv/bin/python -u -m vlm_router_brain
