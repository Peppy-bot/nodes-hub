// vlm_router_brain depends on limb_motion, the backbone's discrete arm and
// gripper moves; the launcher binds that slot to the instance that governs
// the arms, so any move sent through it is collision governed on the way
// down.
//
// The models are the entries of the node's catalog (catalog.json): each has
// a name of its own, the roles it serves, and the routes that reach it, a
// provider and that provider's model id. The node reads the key of a route
// from its own environment, OPENROUTER_API_KEY for openrouter and
// GEMINI_API_KEY for gemini, and takes the first route whose key is set.
// With OPENAI_COMPATIBLE_API_BASE and OPENAI_COMPATIBLE_API_KEY set in its
// environment, the base address of an OpenAI-compatible API and its key,
// the node calls every model through that API instead, under the model's
// catalog name, and reads no provider key; one of the two alone stops the
// node at its start. No key is a parameter, and no key is logged.
{
  peppy_schema: "node/v1",
  manifest: {
    name: "vlm_router_brain",
    tag: "v1",
    description: [
      "A brain whose models are hosted vision-language models that it reaches over the network. It finds items by words in the images of the robot, then picks them up and puts them down. It needs no GPU, but it needs the API key of a model provider, or the address and the key of an OpenAI-compatible API, a local model server among them.",
      "It implements item_perception, item_manipulation and brain_model, which also switches the model of a role while the brain runs. It reads the API key from its environment: GEMINI_API_KEY for Google, OPENROUTER_API_KEY for OpenRouter. With OPENAI_COMPATIBLE_API_BASE and OPENAI_COMPATIBLE_API_KEY set, it calls every model through that OpenAI-compatible API, under the model's catalog name, and reads no provider key. It finds items through one RGB-D camera, the geometry of that camera and its mount on the robot: without them, it refuses each search. The default perception model is Gemini Robotics-ER on the Google API. The default manipulation model grabs an item from above at the point where the brain saw it, and calls no model. A catalog model in the manipulation role also looks through the wrist camera of the arm and corrects the place and the turn of the gripper before the descent. With the robot's motion planner bound, the arm goes to the point above an item, and above the spot of a place, by a path planned around what the chest camera sees.",
    ],
    implements: [
      { name: "item_perception", tag: "v1", link_id: "item_perception" },
      { name: "item_manipulation", tag: "v1", link_id: "item_manipulation" },
      { name: "brain_model", tag: "v1", link_id: "brain_model" },
    ],
    depends_on: {
      contracts: [
        { name: "limb_motion", tag: "v1", link_id: "limb_motion" },
        // The robot's measured limbs, from the backbone that governs them:
        // a grab reads the gripper's opening after the lift from it, to
        // judge whether the item stayed in the jaws. Required: a grab
        // judged from the gripper's opening alone cannot tell a hold from
        // a slip.
        { name: "limb_state", tag: "v1", link_id: "limb_state" },
        // The cameras the arms carry, one rgb producer each, through which
        // a catalog model in the manipulation role looks down past the
        // open jaws and corrects the gripper's place and turn above an
        // item before the descent. The `wrist_cameras` parameter names
        // each arm's camera by the instance id it runs under. Without a
        // camera for the arm, a grab with such a model fails before it
        // moves, naming the arm; the scripted model needs none.
        { name: "rgb_camera", tag: "v1", link_id: "wrist_cameras", cardinality: "zero_or_more" },
        // The camera the brain looks through: colour and depth from one
        // rgbd producer, so a detection's pixel becomes a world position
        // through the depth at that pixel and the camera model below.
        // Optional: without a camera the brain still serves every member,
        // and both searches are refused with "no perception source".
        { name: "rgbd_camera", tag: "v1", link_id: "camera", cardinality: "zero_or_one" },
        // Where that camera's pixels point: its colour intrinsics and lens
        // model, served by the camera node. Bound to the same camera as
        // `camera`. Optional like it: without it no pixel can become a
        // position, so both searches are refused naming the slot until it
        // answers.
        { name: "camera_geometry", tag: "v1", link_id: "geometry", cardinality: "zero_or_one" },
        // The robot frame, the frame the brain holds every place in, from
        // the robot's model. Optional like the two above: without it no
        // pixel can become a position, so both searches are refused naming
        // the slot until it answers and names the robot frame.
        { name: "sensor_mounts", tag: "v1", link_id: "sensor_mounts", cardinality: "zero_or_one" },
        // Where the frame each picture names, of that camera or of a wrist
        // camera, stood in the robot frame when the picture was taken, and
        // where each grab_item and place_item target's frame stood at its
        // timestamp, from the robot's tree of frames.
        // Optional like sensor_mounts: without it no pixel can become a
        // position, so both searches are refused naming the slot.
        { name: "transform_lookup", tag: "v1", link_id: "transform_lookup", cardinality: "zero_or_one" },
        // The robot's motion planner: it plans the arm's transit to the
        // point above an item and above the spot of a place around what the
        // chest camera sees and what its planning scene holds, and the brain
        // runs each plan with limb_motion's execute_joint_path. The brain
        // keeps the scene equal to what it holds: the object of an item it
        // grabs, attached to the arm. Optional: without it the brain moves
        // by move_arm lines alone, which check nothing around the arm.
        { name: "motion_planning", tag: "v1", link_id: "motion_planning", cardinality: "zero_or_one" },
      ],
    },
  },
  interfaces: {
    actions: {
      exposes: [
        { link_id: "item_perception", name: "scan_items" },
        { link_id: "item_perception", name: "identify_item" },
        { link_id: "item_manipulation", name: "grab_item" },
        { link_id: "item_manipulation", name: "drop_item" },
        { link_id: "item_manipulation", name: "place_item" },
        { link_id: "item_manipulation", name: "abort" },
        { link_id: "brain_model", name: "switch_model" },
      ],
      consumes: [
        { link_id: "limb_motion", name: "move_arm" },
        { link_id: "limb_motion", name: "move_gripper" },
        { link_id: "limb_motion", name: "execute_joint_path" },
        { link_id: "motion_planning", name: "plan_joint_path" },
        { link_id: "motion_planning", name: "plan_cartesian_path" },
      ],
    },
    topics: {
      consumes: [
        { link_id: "camera", name: "video_stream" },
        { link_id: "camera", name: "depth_stream" },
        { link_id: "limb_state", name: "limb_states" },
        { link_id: "wrist_cameras", name: "video_stream" },
      ],
    },
    services: {
      exposes: [
        { link_id: "item_manipulation", name: "get_state" },
        { link_id: "brain_model", name: "get_model" },
        { link_id: "brain_model", name: "list_models" },
        { link_id: "brain_model", name: "forget" },
      ],
      consumes: [
        { link_id: "limb_motion", name: "check_arm_move" },
        { link_id: "motion_planning", name: "describe_arms" },
        { link_id: "motion_planning", name: "get_planning_scene" },
        { link_id: "motion_planning", name: "apply_collision_objects" },
        { link_id: "motion_planning", name: "apply_attached_collision_object" },
        { link_id: "motion_planning", name: "set_allowed_collision" },
        { link_id: "camera", name: "depth_stream_info" },
        { link_id: "geometry", name: "get_color_intrinsics" },
        { link_id: "geometry", name: "get_depth_intrinsics" },
        { link_id: "sensor_mounts", name: "describe_sensors" },
        { link_id: "transform_lookup", name: "lookup_transform" },
      ],
    },
  },
  execution: {
    language: "python",
    // The models run at their providers: the container needs the network
    // and no GPU.
    container: {
      def_file: "apptainer.def",
    },
    parameters: {
      // Each arm with the gripper it carries, comma separated, in the order
      // get_state reports the grippers: "left_arm:left_gripper,right_arm:right_gripper"
      // on the OpenArm, "arm:gripper" on the SO-101. They are the names
      // limb_motion addresses, so the launcher names the limbs the robot has.
      limbs: "string",
      // The model perception starts on: a catalog model that serves
      // perception (list_models names them), or "none", which refuses every
      // search naming the missing model. The default is Gemini Robotics-ER
      // on Google's API, the model the perception study measured, which
      // needs GEMINI_API_KEY, or an OpenAI-compatible API that serves it.
      // switch_model changes it while the brain runs.
      perception_model: { $type: "string", $default: "gemini-robotics-er-2-preview" },
      // The model manipulation starts on: "scripted", the default, grabs
      // from above at the item's seen point and needs no model call; a
      // catalog model that serves manipulation runs the same grab with an
      // alignment step, in which that model looks through the arm's wrist
      // camera and the chest camera above the item and corrects the
      // gripper's place and turn before the descent, at most five steps of
      // at most 3 cm and 90 degrees; "none" refuses every sequence naming
      // the missing model, while abort and get_state work.
      manipulation_model: { $type: "string", $default: "scripted" },
      // Each arm with the wrist camera it carries, comma separated, by the
      // instance id the camera runs under in the stack:
      // "left_arm:wrist_left,right_arm:wrist_right" on the OpenArm. An arm
      // named here must be one of `limbs`; an arm not named has no wrist
      // camera. Empty names none.
      wrist_cameras: { $type: "string", $default: "left_arm:wrist_left,right_arm:wrist_right" },
      // The name the camera the brain looks through runs under on the
      // robot, which each search's result names beside the regions of the
      // picture it looked at.
      camera_name: "string",
      // How long a lookup in the robot's tree waits for the robot's
      // transforms of its time (s), from 0 to 1, the longest wait
      // transform_lookup takes; the node stops at its start on any other.
      // They reach the brain after the picture by the robot's own latency,
      // so the launcher sets it for the robot.
      lookup_timeout_s: "f64",
    },
  },
}
