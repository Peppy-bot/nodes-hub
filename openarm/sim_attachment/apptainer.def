Bootstrap: docker
From: peppybot/rust-cargo-base:latest

%labels
    Name openarm-sim-attachment
    Version v1

%files
    . /opt/openarm_sim_attachment

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    cd /opt/openarm_sim_attachment
    cargo build --release

%runscript
    cd /opt/openarm_sim_attachment
    exec ./target/release/openarm_sim_attachment "$@"
