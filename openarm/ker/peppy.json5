// openarm_ker: the commander driven by the OpenArm KER (Kinematic
// Equivalent Replica), enactic's motorless bimanual leader arm. Reads the
// KER's encoder frames from its M5Stack CoreS3 over USB vendor mode (or
// serial CDC), maps the channels to per-side joint radians and commanded
// gripper openings, and streams both to the backbone over the
// joint_link / gripper_link pairings exactly like openarm_web_commander (the
// backbone governs everything before it reaches a follower). An arm engages
// when its trigger is squeezed to engage_trigger_opening, having read back
// above it first, and then tracks the KER; for an unengaged arm, a stale KER,
// or a disconnected one the node emits nothing and those limbs hold at their
// last setpoints.
// KER's joint structure matches OpenArm v2 1:1 (links scaled to 70%), so no
// coordinate transform is involved; v1 followers accept the same joint-space
// stream but are not geometrically equivalent.
{
  peppy_schema: "node/v1",
  manifest: {
    name: "openarm_ker",
    tag: "v1",
    depends_on: {
      pairings: [
        // The exclusive command loop with the backbone, one slot per driven
        // limb: this leader plays the leader role and streams the raw
        // setpoints; the backbone governs them. The state back-channels are
        // not consumed (the leader is open loop). Optional so a bring-up
        // launch can boot the leader unbound.
        { name: "joint_link", tag: "v1", role: "leader", link_id: "left_arm", cardinality: "zero_or_one" },
        { name: "joint_link", tag: "v1", role: "leader", link_id: "right_arm", cardinality: "zero_or_one" },
        { name: "gripper_link", tag: "v1", role: "leader", link_id: "left_gripper", cardinality: "zero_or_one" },
        { name: "gripper_link", tag: "v1", role: "leader", link_id: "right_gripper", cardinality: "zero_or_one" },
      ],
    },
  },
  interfaces: {
    // Streams both arms' leader setpoints and both trigger openings to the
    // backbone on the per-limb pairing slots. governor_control stays owned by
    // the openarm_web_commander panel: this node produces motion, not governor
    // tuning.
    topics: {
      emits: [
        { link_id: "left_arm", name: "joint_setpoints" },
        { link_id: "right_arm", name: "joint_setpoints" },
        { link_id: "left_gripper", name: "gripper_setpoints" },
        { link_id: "right_gripper", name: "gripper_setpoints" },
      ],
    },
  },
  execution: {
    language: "rust",
    container: {
      def_file: "apptainer.def",
    },
    parameters: {
      // "usb" reads the M5Stack in vendor mode (VID 0x303A, PID 0x4002, bulk
      // endpoints), which is what enactic's released firmware streams.
      // "serial" reads a CDC device at device_path/serial_baud, which a
      // firmware built without USE_USB streams instead.
      transport: { $type: "string", $default: "usb" },
      device_path: { $type: "string", $default: "/dev/openarm/ker" },
      serial_baud: { $type: "u32", $default: 2000000 },
      // Follower generation ("v1" or "v2"): picks the joint clamp ranges (URDF
      // limits). Required so a launch clamps to the arm it actually drives.
      hardware_version: "string",
      // Rate (Hz, 1..=1000) at which engaged setpoints are re-published on
      // the arm and gripper pairing slots.
      command_rate_hz: "u32",
      // Engage an arm when its trigger opening (1 released, 0 fully squeezed)
      // reaches this value or below (at least 0, under 1); a smaller value
      // demands a deeper squeeze.
      // The trigger must first read back above this value for a few frames, so
      // a device returning under a held trigger stays put. From the engaging
      // frame the arm and its gripper track the KER. That same squeeze
      // commands the gripper, so an arm engages with its gripper near shut.
      // Required: how deep a squeeze starts motion is a deployment choice.
      engage_trigger_opening: "f64",
      // Opening commanded at a released trigger; a squeeze spans [0, this].
      gripper_open_fraction: { $type: "f64", $default: 1.0 },
      // Stop publishing when the newest KER frame is older than this (s); the
      // followers then hold their last setpoints. A frame arriving after a gap
      // this long also disengages both arms. Refused below 0.005 s, five frame
      // periods of the KER's 1 kHz stream.
      stale_timeout_s: { $type: "f64", $default: 0.25 },
      // Bring-up aid: log the raw channel table (degrees, unmapped) at 1 Hz.
      log_raw: { $type: "bool", $default: false }
    }
  }
}
