Bootstrap: docker
From: peppybot/rust-cargo-base:latest

%labels
    Name openarm-arm-sim
    Version v1

%files
    . /opt/openarm_sim_arm

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    cd /opt/openarm_sim_arm
    cargo build --release

%runscript
    cd /opt/openarm_sim_arm
    exec ./target/release/openarm_sim_arm "$@"
