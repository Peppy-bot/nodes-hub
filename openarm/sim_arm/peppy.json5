// openarm_sim_arm: the sim arm follower, a simulation-agnostic relay between two
// joint_link pairings. Toward the backbone it plays the follower role exactly
// like the real arm (governed setpoints in, measured state back); toward the
// simulation it plays the leader role of the same pairing (setpoints down to
// the simulation's matching limb slot, the simulation's measured state back up).
// Stamps pass through unchanged, so consumers age samples on the original
// capture time. One instance per limb; the slots carry the side for the
// command loop, and the health heartbeat is attributed to this instance by
// the transport.
{
  peppy_schema: "node/v1",
  manifest: {
    name: "openarm_sim_arm",
    tag: "v1",
    implements: [
      // Per-component readiness openarm_initializer aggregates, exactly like
      // the real follower: ready once the simulation's first state has been
      // relayed (this limb's physics is live and serving).
      { name: "component_ready", tag: "v1", link_id: "ready" },
      // Same health surface as the real arm, published as "present, not
      // sensed": nominal levels, empty reading vectors (the simulation reports no
      // effort or temperature).
      { name: "motor_health", tag: "v1", link_id: "motor_health" },
    ],
    depends_on: {
      pairings: [
        // The exclusive command loop with the backbone, identical to the real
        // arm's slot: optional, established at the backbone's start.
        { name: "joint_link", tag: "v1", role: "follower", link_id: "backbone", optional: true },
        // The same pairing toward the simulation's matching limb slot: this
        // relay leads, the simulation follows. Required: a relay without a
        // simulation is a misconfiguration, so the launch fails loudly instead.
        { name: "joint_link", tag: "v1", role: "leader", link_id: "simulation" }
      ]
    }
  },
  interfaces: {
    topics: {
      emits: [
        { link_id: "backbone", name: "joint_states" },
        { link_id: "simulation", name: "joint_setpoints" },
        { link_id: "motor_health", name: "motor_health" },
      ],
      consumes: [
        { link_id: "backbone", name: "joint_setpoints" },
        { link_id: "simulation", name: "joint_states" },
      ],
    },
    services: {
      exposes: [
        { link_id: "ready", name: "is_ready" },
      ],
    },
  },
  execution: {
    language: "rust",
    container: {
      def_file: "apptainer.def"
    }
  }
}
