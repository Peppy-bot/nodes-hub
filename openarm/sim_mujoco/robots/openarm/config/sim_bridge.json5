// Engine wiring for the OpenArm scenes this engine stands: the joint layout
// the bridge splits measured state by and maps setpoints onto, plus the MIT
// servo gains. Both scenes carry these limbs under these names. Transport is
// typed peppygen (joint_states / gripper_states on the limb slots, contract
// arrays per limb); no topic names live here.
{
  // Per-arm joints, j1..j7, in order. The name is the limb's identity end to
  // end: the pairing slot the robot is driven through, and the position of
  // that arm in every array of the simulation_robot contract.
  arms: [
    {
      name: "left",
      joints: [
        "openarm_left_joint1", "openarm_left_joint2", "openarm_left_joint3",
        "openarm_left_joint4", "openarm_left_joint5", "openarm_left_joint6",
        "openarm_left_joint7",
      ],
    },
    {
      name: "right",
      joints: [
        "openarm_right_joint1", "openarm_right_joint2", "openarm_right_joint3",
        "openarm_right_joint4", "openarm_right_joint5", "openarm_right_joint6",
        "openarm_right_joint7",
      ],
    },
  ],

  // Per-gripper finger joints; the bridge maps the commanded opening fraction
  // onto each finger's own model travel and averages the travel fractions back
  // into the measured opening.
  grippers: [
    { name: "left", fingers: ["openarm_left_finger_joint1", "openarm_left_finger_joint2"] },
    { name: "right", fingers: ["openarm_right_finger_joint1", "openarm_right_finger_joint2"] },
  ],

  // MIT servo gains (j1..j7) applied to each arm's position actuators so sim
  // dynamics match the real driver; gravity_compensation mirrors the real
  // in-process gravity feedforward. Fingers keep their MJCF defaults.
  arm_gains: {
    kp: [240.0, 240.0, 240.0, 240.0, 24.0, 31.0, 25.0],
    kd: [3.0, 3.0, 3.0, 3.0, 0.2, 0.2, 0.2],
    gravity_compensation: true,
  },
}
