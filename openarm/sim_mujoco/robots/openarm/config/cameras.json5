// Robot-mounted sim cameras. name doubles as the node's pairing slot
// (link_id). Placement is in the parent link's frame; parent_link is the URDF
// link name, and each engine resolves it against its own scene (a link welded
// into the world by the MJCF compiler carries no body of its own, so the
// MuJoCo engine maps it to the world body).
//
// Camera frame convention: the camera looks along its own -Z with +Y as
// image-up, so an identity quat_wxyz looks along the parent's -Z axis. MJCF
// <camera> and UsdGeom.Camera agree on this, so one pose serves both.
//
// Geometry comes from Enactic's published OpenArm v2 sources:
// - Wrist cameras: openarm_mujoco v2/openarm_bimanual.xml, whose cameras are
//   children of the same openarm_{side}_ee_base_link this config parents to,
//   so position and orientation carry over verbatim (their euler of
//   -+21deg, 13deg, -90deg as the equivalent quaternion). The pair mirrors
//   about Y, image-up pointing back toward the arm on both sides.
// - Chest camera: the OpenArm_2.0_w_Head_Camera CAD assembly in
//   openarm_hardware, whose ZED Mini mount sits 65mm forward of and 123.8mm
//   above the shoulder-mount plane (z=0.698 here, 697mm in CAD), tilted
//   28deg off vertical. Its tilt constants match openarm_mujoco v2/cell.xml
//   exactly, though that file's head camera belongs to the Cell's separate
//   world-mounted lifter rig, so only its orientation corroborates.
//
// Neither source publishes an optical-frame calibration: CAD part origins are
// bracket references, and Enactic's own commented-out description example says
// to tune from CAD or calibration before trusting a pose on hardware. Stream
// geometry mirrors the real v2 record rig (960x600 wrists, hd720 chest with
// depth at downscale 2, all at 15fps).
{
  cameras: [
    {
      name: "wrist_left",
      parent_link: "openarm_left_ee_base_link",
      pos: [0.023, 0.0182, -0.10236],
      quat_wxyz: [0.6762086, -0.2067369, -0.0493266, -0.7053855],
      fovy_deg: 66.0,
      color: { width: 960, height: 600 },
      fps: 15,
    },
    {
      name: "wrist_right",
      parent_link: "openarm_right_ee_base_link",
      pos: [0.023, -0.0182, -0.10236],
      quat_wxyz: [0.7053830, 0.0493258, 0.2067371, -0.6762112],
      fovy_deg: 66.0,
      color: { width: 960, height: 600 },
      fps: 15,
    },
    {
      name: "chest",
      parent_link: "openarm_body_link0",
      // Shoulder-mount plane plus the CAD mount offset, at the ZED Mini's
      // left eye (+Y by half the 62.9mm baseline): the rgbd stream is the
      // rectified left eye.
      pos: [0.065, 0.0315, 0.8218],
      // Faces the robot's front (world +X, where j1 pitches the arms) 62deg
      // below the horizon, image-up leaning forward.
      quat_wxyz: [0.6861027, 0.1710647, -0.1710647, -0.6861027],
      fovy_deg: 52.0,
      color: { width: 1280, height: 720 },
      // The ZED Mini's hardware near limit (0.1 m), not the real node's 0.4:
      // that floor is an SGM stereo-quality bound, and rendered depth has no
      // matching cost, so inheriting it would zero the arms whenever they
      // come near the camera.
      depth: { width: 640, height: 360, min_depth_m: 0.1, max_range_m: 10.0 },
      fps: 15,
    },
  ],
}
