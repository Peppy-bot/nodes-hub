{
  peppy_schema: "node/v1",

  manifest: {
    name: "openarm_scene_commander",
    tag: "v1",

    labels: [
      "openarm",
      "simulation",
      "scene",
      "commander",
      "web",
    ],

    depends_on: {
      contracts: [
        // The scene editing surface of whichever simulation engine the
        // launcher binds here.
        { name: "scene_control", tag: "v1", link_id: "simulation" },
        // The same engine's world selection (the robots it can stand up
        // and the switch between them), when it has one: only the Waldo
        // engine implements it, so the slot may run vacant and the panel
        // then shows no robot menu.
        { name: "world_control", tag: "v1", link_id: "worlds", cardinality: "zero_or_one" },
      ],
    },
  },

  interfaces: {
    services: {
      consumes: [
        {
          link_id: "simulation",
          name: "get_assets_list",
        },
        {
          link_id: "simulation",
          name: "get_objects_list",
        },
        {
          link_id: "worlds",
          name: "get_worlds_list",
        },
      ],
    },

    actions: {
      consumes: [
        {
          link_id: "worlds",
          name: "load_world",
        },
        {
          link_id: "simulation",
          name: "load_scene",
        },
        {
          link_id: "simulation",
          name: "clear_scene",
        },
        {
          link_id: "simulation",
          name: "spawn_object",
        },
        {
          link_id: "simulation",
          name: "move_object",
        },
        {
          link_id: "simulation",
          name: "remove_object",
        },
        {
          link_id: "simulation",
          name: "apply_force",
        },

        {
          link_id: "simulation",
          name: "move_robot",
        },
      ],
    },
  },

  execution: {
    language: "python",

    container: {
      def_file: "apptainer.def",
    },

    parameters: {
      http_host: {
        $type: "string",
        $default: "0.0.0.0",
      },

      http_port: {
        $type: "u32",
        $default: 8766,
      },
    },
  },
}
