Bootstrap: docker
From: peppybot/python-uv-base:latest

%labels
    Name openarm_ai_brain_vla
    Version v1

%environment
    export PATH="/opt/openarm_ai_brain_vla/.venv/bin:$PATH"

%files
    . /opt/openarm_ai_brain_vla

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    # Keep the interpreter out of the container user's home directory. uv
    # installs managed Pythons under $HOME, and at run time apptainer mounts
    # the daemon user's home over the image's own, hiding whatever the build
    # left there. A daemon running as root hides /root every time: the venv
    # builds fine and then dies at exec with `./.venv/bin/python: not found`.
    export UV_PYTHON_INSTALL_DIR=/opt/uv-python

    # OpenCV, which ultralytics imports for the yoloe_vp backend, links the
    # GL, glib and xcb shared libraries the base image does not carry.
    apt-get update -qq
    apt-get install -qqy --no-install-recommends libgl1 libglib2.0-0t64 libxcb1
    rm -rf /var/lib/apt/lists/*

    cd /opt/openarm_ai_brain_vla
    uv python install
    # The brain whose models run beside the robot: the sam3-siglip and yoloe
    # extras bring torch, transformers and ultralytics into the image, and
    # the manifest passes --nv so they see the host's GPU; gemini brings the
    # API client. Every backend is installed so a launcher can choose one
    # without a rebuild.
    uv sync --no-editable --no-dev --extra sam3-siglip --extra yoloe --extra gemini

%runscript
    cd /opt/openarm_ai_brain_vla
    exec ./.venv/bin/python -u -m openarm_ai_brain_vla