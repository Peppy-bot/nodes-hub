Bootstrap: docker
From: peppybot/rust-cargo-base:latest

%labels
    Name openarm-gripper-sim
    Version v1

%files
    . /opt/openarm_sim_gripper

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    cd /opt/openarm_sim_gripper
    cargo build --release

%runscript
    cd /opt/openarm_sim_gripper
    exec ./target/release/openarm_sim_gripper "$@"
