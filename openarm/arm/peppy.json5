// Instantiate openarm_arm twice, one per side, with a distinct `arm_id`. The
// feedforward comes from the in-process srs_model, built from the embedded
// description of `hardware_version`.
{
  peppy_schema: "node/v1",
  manifest: {
    name: "openarm_arm",
    tag: "v1",
    description: [
      "One arm of a real OpenArm robot, v1.0 or v2.0: it drives the seven joint motors of the arm over a CAN interface of its host. It needs the arm hardware on that CAN interface. A robot runs one instance per arm.",
      "It follows the governed setpoints of openarm_backbone over a joint_link pairing and streams the measured joint states back. It runs the control loop of the hardware (gravity, Coriolis and friction feedforward, plus MIT control) and has no motion logic of its own: the backbone plans and governs every move. It also reports its readiness, the health of each motor, and alerts for a motor that runs hot, is overloaded or has a fault.",
    ],
    implements: [
      // Per-component readiness a real robot's robot_initializer aggregates:
      // ready once motors are enabled and the control loop is serving.
      { name: "component_ready", tag: "v1", link_id: "ready" },
      // Per-motor health telemetry: severity, effort fraction, and
      // temperatures, naming this arm as its source.
      { name: "motor_health", tag: "v1", link_id: "motor_health" },
      // Operator alerts: a motor running hot, overloaded, or faulted. Any
      // alert consumer renders these without knowing this node exists.
      { name: "alert", tag: "v1", link_id: "alerts" },
    ],
    depends_on: {
      pairings: [
        // The exclusive command loop with the backbone: governed setpoints stream in
        // and the measured state streams back, both scoped to the pair (no
        // arm_id demux). Optional: the arm boots and holds with no backbone paired,
        // and the pair is established at the backbone's start (launcher `links:`).
        { name: "joint_link", tag: "v1", role: "follower", link_id: "backbone", cardinality: "zero_or_one" },
      ],
    },
  },
  interfaces: {
    topics: {
      emits: [
        // The `backbone` pairing slot: the topic this role emits.
        { link_id: "backbone", name: "joint_states" },
        { link_id: "motor_health", name: "motor_health" },
        { link_id: "alerts", name: "alerts" },
      ],
      consumes: [
        // The counterpart role's topic on the same slot.
        { link_id: "backbone", name: "joint_setpoints" },
      ],
    },
    services: {
      exposes: [
        { link_id: "ready", name: "is_ready" },
      ],
    },
  },
  execution: {
    language: "rust",
    container: {
      def_file: "apptainer.def",
      // Where the instance lock on this node's device lives. Bound so every
      // instance on the host locks the one file.
      mount_paths: ["/tmp/peppy_instance_locks"],
    },
    parameters: {
      arm_id: "u8",
      can_interface: "string",
      // Which OpenArm hardware generation this arm drives: "v1" or "v2". Selects the
      // embedded description (URDF, joint limits, elbow margin) the in-process model is
      // built from. Required, not defaulted: running the wrong generation's model on the
      // hardware would mis-compensate gravity/Coriolis, so the launcher must be explicit.
      hardware_version: "string",
      // Hardware-loop rate (Hz). Required: pick deliberately per deployment. The
      // stack currently unifies on 100 Hz (backbone stream rate and arm loop rate match);
      // confirm `overruns=0` at the target rate during bring-up.
      control_rate_hz: "u32",
      // Per-cycle CAN read deadline (μs). Must fit the cycle budget (10 ms at 100 Hz).
      recv_timeout_us: { $type: "u32", $default: 1000 },
      // MIT-control gains applied every control tick, one per joint (1-indexed).
      // Match the openarm teleop config (Kp/Kd).
      kp1: { $type: "f64", $default: 240.0 },
      kp2: { $type: "f64", $default: 240.0 },
      kp3: { $type: "f64", $default: 240.0 },
      kp4: { $type: "f64", $default: 240.0 },
      kp5: { $type: "f64", $default: 24.0 },
      kp6: { $type: "f64", $default: 31.0 },
      kp7: { $type: "f64", $default: 25.0 },
      kd1: { $type: "f64", $default: 3.0 },
      kd2: { $type: "f64", $default: 3.0 },
      kd3: { $type: "f64", $default: 3.0 },
      kd4: { $type: "f64", $default: 3.0 },
      kd5: { $type: "f64", $default: 0.2 },
      kd6: { $type: "f64", $default: 0.2 },
      kd7: { $type: "f64", $default: 0.2 },
      // Rate (Hz) of the always-on measured-state stream (`joint_states`), which the
      // backbone consumes. Required: consumers' needs vary too much for a default.
      state_rate_hz: "u32",
    }
  },
}
