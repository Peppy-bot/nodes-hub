// so101_backbone: the upstream command is joints (joint_link) or an
// end-effector pose (pose_link), never both: `upstream_mode` picks one per
// instance and only that slot kind is subscribed. Poses are solved with
// placo's kinematics against the URDF of SO-101's model in
// robot_description, the model its postures and limits are read from.
{
  peppy_schema: "node/v1",
  manifest: {
    name: "so101_backbone",
    tag: "v1",
    description: [
      "The motion authority of an SO-101 robot, one arm with a gripper: it plans and streams every move of the arm and its gripper. It opens no device: it drives so101_follower, or a simulation, over the downstream pairings.",
      "\"Leader\" and \"follower\" here name pairing roles, not the lerobot arms. The node plays the follower role toward the commander (so101_leader, xr_commander, a policy runner): raw setpoints stream in on the leader_* slots and the measured state relays back up them. It plays the leader role toward the arm and the gripper. It runs the joint, Cartesian and gripper moves itself, and answers where the robot can work (workspace) from its design alone. Everything the follower executes leaves through the arm and gripper slots, so a recorder that observes those slots captures teleoperation and moves identically.",
      "Every pose this node reports or takes is the fixed gripper_frame_link TCP of the URDF: the limb_state poses, the limb_motion goal and result poses, the postures result poses and the grasp point of the workspace answers. On this gripper, with one moving jaw, the midpoint of the pads shifts with the opening, so no static frame is exactly the grasp point of the contracts.",
    ],
    implements: [
      // Whole-robot state snapshots for consumers that hold no pairing:
      // joint positions, the end-effector pose, and the gripper opening.
      { name: "limb_state", tag: "v1", link_id: "limb_state" },
      // The per-limb moves: the arm to a joint target, through a joint path
      // or to an end-effector pose, the gripper to an opening. This robot's
      // limb names are "arm" and "gripper".
      { name: "limb_motion", tag: "v1", link_id: "limb_motion" },
      // Whole-robot posture moves, executed through the same admission and
      // trajectory path as move_arm_joints. move_to_home first closes the
      // gripper, a gripper plan as move_gripper installs one.
      { name: "postures", tag: "v1", link_id: "postures" },
      // Where the robot can work, from its design alone: where its arm
      // reaches, in the robot frame (the URDF's base_link frame), on a flat,
      // level surface at a given height or at given points. The robot has no
      // perception camera (its one camera, wrist, rides the arm), so the
      // answers are on reach alone.
      { name: "workspace", tag: "v1", link_id: "workspace" },
    ],
    depends_on: {
      pairings: [
        // Upstream: the exclusive command loop with the one leading node.
        // Optional: action-only sessions boot with these unbound.
        // Subscribed only under upstream_mode "joints".
        { name: "joint_link", tag: "v1", role: "follower", link_id: "leader_arm", cardinality: "zero_or_one" },
        // The Cartesian alternative: a world-frame end-effector pose streams
        // in and the measured pose relays back. Subscribed only under
        // upstream_mode "pose".
        { name: "pose_link", tag: "v1", role: "follower", link_id: "leader_pose", cardinality: "zero_or_one" },
        { name: "gripper_link", tag: "v1", role: "follower", link_id: "leader_gripper", cardinality: "zero_or_one" },
        // Downstream: the exclusive command loops with the follower. The
        // slots scope both directions, so no id demux and no other producer
        // can pose as the arm. Each slot takes its limb's own name, the one
        // the robot answers to in limb_motion and limb_state: a simulation
        // engine learns which limb a pair drives from the name of the link on
        // this side.
        { name: "joint_link", tag: "v1", role: "leader", link_id: "arm", cardinality: "zero_or_one" },
        { name: "gripper_link", tag: "v1", role: "leader", link_id: "gripper", cardinality: "zero_or_one" },
      ],
      contracts: [
        // The robot's model and its description. The backbone asks for them
        // once its setup has returned, while it serves, until the initializer
        // answers, and ends when the model is not so101 or the description's
        // digest is not the one it was built with.
        { name: "robot_identity", tag: "v1", link_id: "robot_identity" },
      ],
    },
  },
  interfaces: {
    actions: {
      // The backbone's move actions. The backbone runs each move itself
      // (trajectory + velocity caps + streamed setpoints); progress is
      // observed on the state streams. Discrete goals that return a result,
      // distinct from the streamed setpoints on the upstream pairing slots.
      exposes: [
        // The postures contract's actions; formats come from the contract.
        { link_id: "postures", name: "move_to_ready" },
        { link_id: "postures", name: "move_to_home" },
        // The limb_motion contract's actions; formats come from the
        // contract. An SO-101 arm has five joints, so the joint move's
        // generic joint vectors are pinned to that length: a goal carrying
        // any other count is refused before the handler runs.
        {
          link_id: "limb_motion",
          name: "move_arm_joints",
          refine: {
            goal_service: {
              request_message_format: {
                joint_positions: { $length: 5 },
                settle_tolerances_rad: { $length: 5 },
              },
            },
            result_service: {
              response_message_format: { final_joint_positions: { $length: 5 } },
            },
          },
        },
        // The joint path pins each waypoint, the settle tolerances and the
        // final joints of its one arm to the five joints the same way. An
        // empty expected start is not checked, so that vector keeps its free
        // length, and the handler refuses any length but 0 and 5.
        {
          link_id: "limb_motion",
          name: "execute_joint_path",
          refine: {
            goal_service: {
              request_message_format: {
                arms: {
                  $items: {
                    waypoints: { $items: { joint_positions: { $length: 5 } } },
                    settle_tolerances_rad: { $length: 5 },
                  },
                },
              },
            },
            result_service: {
              response_message_format: {
                arms: { $items: { final_joint_positions: { $length: 5 } } },
              },
            },
          },
        },
        // The move is a straight line: one verified solve per sample of it, the
        // grasp point within 1 mm of its sample and the orientation free along
        // the way, the last sample landing within 0.01 rad of a named orientation.
        // The joint limits and the goal's duration time the move through the
        // line's configurations.
        //
        // Fails a share of reachable poses with `unreachable`: the solver is a
        // local descent from the arm's current posture, and 271 of 300 reachable
        // poses near an arbitrary posture walk their line. Such a failure means
        // this branch did not walk the line, not that the arm cannot reach the
        // pose. Five joints underactuate the three rotations, so a goal off a
        // reachable orientation often has no plan, and one that leaves orientation
        // out is a position alone. See so101/README.md.
        { link_id: "limb_motion", name: "move_arm" },
        { link_id: "limb_motion", name: "move_gripper" },
      ]
    },
    topics: {
      emits: [
        // The leader role's topic on each downstream slot.
        { link_id: "arm", name: "joint_setpoints", refine: { message_format: { positions: { $length: 5 } } } },
        { link_id: "gripper", name: "gripper_setpoints" },
        // The follower role's state back-channel on each upstream slot: the
        // measured state relayed from the matching downstream pair.
        { link_id: "leader_arm", name: "joint_states", refine: { message_format: { positions: { $length: 5 } } } },
        { link_id: "leader_gripper", name: "gripper_states" },
        // The measured end-effector pose (FK of the measured joints).
        // Published only under upstream_mode "pose".
        { link_id: "leader_pose", name: "pose_states" },
        // The contract-backed whole-robot readout; format comes from the
        // contract.
        { link_id: "limb_state", name: "limb_states" },
      ],
      consumes: [
        { link_id: "arm", name: "joint_states", refine: { message_format: { positions: { $length: 5 } } } },
        { link_id: "gripper", name: "gripper_states" },
        { link_id: "leader_arm", name: "joint_setpoints", refine: { message_format: { positions: { $length: 5 } } } },
        { link_id: "leader_pose", name: "pose_setpoints" },
        { link_id: "leader_gripper", name: "gripper_setpoints" },
      ],
    },
    services: {
      exposes: [
        // The robot's limb vocabulary, answered from the same names that
        // label limb_states, so a consumer can address a limb before a
        // snapshot has been published.
        { link_id: "limb_state", name: "get_limb_names" },
        // The stop of every planned move in flight, whoever started it, and
        // the plan check of a Cartesian move that moves nothing: the same
        // solve a move_arm goal runs, from the same anchor.
        { link_id: "limb_motion", name: "stop" },
        { link_id: "limb_motion", name: "check_arm_move" },
        // Where the robot can work on a surface and whether it can work
        // given points, answered from bringup: they read the design, never
        // the arm, so they move nothing and need no follower state. The
        // reach is measured in a worker process with a solver of its own,
        // and the reach of the last 32 surface heights is kept.
        { link_id: "workspace", name: "describe_workspace" },
        { link_id: "workspace", name: "check_positions" },
      ],
      consumes: [
        { link_id: "robot_identity", name: "get_identity" },
        { link_id: "robot_identity", name: "get_description" },
      ],
    },
  },
  execution: {
    language: "python",
    container: {
      def_file: "apptainer.def",
    },
    parameters: {
      // Which upstream command kind this instance follows: "joints"
      // (joint_link: so101_leader, a policy runner) or "pose" (pose_link:
      // xr_commander, a keyboard teleop). Only the named kind is subscribed;
      // a leader linked to the other kind streams into a slot nothing reads.
      upstream_mode: "string",
      // Coordination loop rate (Hz, 1..=1000): the rate setpoints stream
      // downstream. 60 is the validated rate; in pose mode the streaming IK
      // runs inside the tick, so higher rates are untested there.
      control_rate_hz: "u32",
      // Per-joint peak velocity (rad/s), shoulder_pan..wrist_roll: sizes every
      // action and bounds every stream's per-tick joint steps. The URDF's joint
      // velocity limits. Universal control constants for this arm, so they keep
      // node defaults like gains.
      max_joint_velocity_rad_s_1: { $type: "f64", $default: 10.0 },
      max_joint_velocity_rad_s_2: { $type: "f64", $default: 10.0 },
      max_joint_velocity_rad_s_3: { $type: "f64", $default: 10.0 },
      max_joint_velocity_rad_s_4: { $type: "f64", $default: 10.0 },
      max_joint_velocity_rad_s_5: { $type: "f64", $default: 10.0 },
      // Per-joint peak acceleration (rad/s²), shoulder_pan..wrist_roll, that
      // every action is timed within, with the velocity caps above. A move across
      // the widest joint's range, wrist_roll's 5.585 rad, peaks at 2 rad/s at it:
      // (2 rad/s)² / 5.585 rad. Under
      // the 38.96 rad/s² ramp each STS3215 runs its position goals at (lerobot
      // 0.6.1's SOFollower.configure writes the Acceleration register, in units
      // of 100 steps/s², 4096 steps a turn, to 254). Provisional until a hardware
      // run confirms it. Universal control constants for this arm, so they keep
      // node defaults like the velocity caps.
      max_joint_acceleration_rad_s2_1: { $type: "f64", $default: 0.72 },
      max_joint_acceleration_rad_s2_2: { $type: "f64", $default: 0.72 },
      max_joint_acceleration_rad_s2_3: { $type: "f64", $default: 0.72 },
      max_joint_acceleration_rad_s2_4: { $type: "f64", $default: 0.72 },
      max_joint_acceleration_rad_s2_5: { $type: "f64", $default: 0.72 },
      // End-effector speed cap (m/s) on every stream, and on nothing else. A
      // streamed sample within it passes through untouched; one that would
      // exceed it moves the end effector at cap speed along the same path. An
      // operational choice with no safe universal value, so the launcher states
      // it (openarm's backbone holds the same parameter).
      max_stream_ee_velocity_m_s: "f64",
      // Peak gripper travel rate (fraction of full travel per second);
      // within one tick's step the leader's opening passes through exactly.
      max_gripper_rate_frac_s: "f64",
      // The farthest (rad) any measured joint may stand from a joint path
      // goal's expected_start_joint_positions as the path starts, and from
      // where the arm holds once the path is planned: while the path is
      // planned the arm holds at its measured joints, moved inside the joint
      // limits where it stood past one, and a measured joint, clamped the
      // same way, that then stands farther from there has moved. Past it the
      // goal fails with precondition_failed and runs none of the path. An
      // operational choice with no safe universal value, so the launcher
      // states it.
      start_tolerance_rad: "f64",
    },
  },
}
