// so101_leader: the node is named after the hardware (mixed gearing for
// light feel, torque disabled throughout); on the wire it is one commander
// among several.
{
  peppy_schema: "node/v1",
  manifest: {
    name: "so101_leader",
    tag: "v1",
    description: [
      "The commander driven by the SO-101 leader arm, the passive twin of the follower in lerobot, with the same six STS3215 servos. It needs the leader arm on a serial device of its host and its lerobot calibration file: it refuses to start uncalibrated.",
      "It reads the joint positions off the serial bus, maps them to radians and the gripper to an opening fraction, and streams both to the backbone in the leader role of the joint_link and gripper_link pairings, as xr_commander does on pose_link. It is open loop: it reads no state back. The leader arm has no engage button, so the deadman is staleness alone: a silent or unplugged device stops the stream within stale_timeout_s and the follower holds.",
    ],
    depends_on: {
      pairings: [
        { name: "joint_link", tag: "v1", role: "leader", link_id: "arm", cardinality: "zero_or_one" },
        { name: "gripper_link", tag: "v1", role: "leader", link_id: "gripper", cardinality: "zero_or_one" },
      ],
    },
  },
  interfaces: {
    topics: {
      emits: [
        { link_id: "arm", name: "joint_setpoints", refine: { message_format: { positions: { $length: 5 } } } },
        { link_id: "gripper", name: "gripper_setpoints" },
      ],
    },
  },
  execution: {
    language: "python",
    container: {
      def_file: "apptainer.def",
      mount_paths: [
        "${parameters:device_path}:${parameters:device_path}:rw",
        "${parameters:calibration_dir}",
      ],
    },
    parameters: {
      // Serial device of the leader's motor bus (stable udev symlink).
      device_path: "string",
      // Host directory of lerobot calibration JSONs; the file used is
      // <calibration_dir>/<teleop_id>.json, written by lerobot-calibrate.
      // The node refuses to start uncalibrated.
      calibration_dir: "string",
      // Calibration identity (file stem) of this leader arm.
      teleop_id: "string",
      // Rate (Hz) the device is read and fresh setpoints are published at.
      command_rate_hz: "u32",
      // Stop publishing when the newest read is older than this (s); the
      // follower then holds. Must be at least two read periods, or the
      // phase-independent publish ticks would flap.
      stale_timeout_s: { $type: "f64", $default: 0.25 },
    },
  },
}
