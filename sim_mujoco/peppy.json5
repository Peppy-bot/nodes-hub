// The MuJoCo simulation node. It stands any number of robots, each joining
// by attaching over the simulation_robot contract, naming the copy it runs
// as, the model it is and where it stands; the engine composes its scene
// from the models standing in it and steps them for as long as they stay.
// The engine plays the follower role of every limb pairing of every robot:
// a robot's backbone leads each pair and the simulation's measured state
// streams back on it. Whether a robot stands with a pair for every limb of
// its model is its readiness, answered on the same contract.
{
  peppy_schema: "node/v1",
  manifest: {
    name: "sim_mujoco",
    tag: "v1",
    implements: [
      // How a robot joins this scene: it attaches with the copy it runs as,
      // its model and the spot it stands on, and stays for as long as its
      // goal runs. A robot that asks for no spot takes a free one of the
      // engine's own. Whether it stands with every limb paired is its
      // readiness.
      { name: "simulation_robot", tag: "v1", link_id: "robots" },
    ],
    depends_on: {
      pairings: [
        // The engine plays the follower role of every limb's pairing, one
        // slot per kind of limb, each holding any number of pairs: governed
        // setpoints stream in, the robot's measured state streams back on
        // the same pair. A pair's robot is the copy it carries and its limb
        // is the link it comes from on the robot's side (left_arm, arm), so
        // nothing on the wire carries an arm_id or a robot id, and a robot
        // of any model pairs here. A robot whose pairs are not the limbs and
        // cameras of its model does not stay.
        { name: "joint_link", tag: "v1", role: "follower", link_id: "arms", cardinality: "zero_or_more" },
        { name: "gripper_link", tag: "v1", role: "follower", link_id: "grippers", cardinality: "zero_or_more" },
        // Robot-mounted cameras rendered from the live scene, one slot per
        // kind of camera: the engine plays the camera role and a per-camera
        // relay presents the rgb/rgbd contract. A pair's camera is its
        // relay's name in the copy (wrist_left, front), and it is rendered
        // for the robot of its pair, so a stack that pairs no camera renders
        // none and pays for none.
        { name: "sim_rgb_camera_link", tag: "v1", role: "camera", link_id: "rgb_cameras", cardinality: "zero_or_more" },
        { name: "sim_rgbd_camera_link", tag: "v1", role: "camera", link_id: "rgbd_cameras", cardinality: "zero_or_more" },
      ],
    },
  },
  interfaces: {
    services: {
      exposes: [
        { link_id: "robots", name: "is_ready" },
      ],
    },
    actions: {
      exposes: [
        { link_id: "robots", name: "attach" },
      ],
    },
    topics: {
      emits: [
        { link_id: "arms", name: "joint_states" },
        { link_id: "grippers", name: "gripper_states" },
        { link_id: "rgb_cameras", name: "video_stream" },
        { link_id: "rgb_cameras", name: "stream_info" },
        { link_id: "rgb_cameras", name: "geometry" },
        { link_id: "rgbd_cameras", name: "video_stream" },
        { link_id: "rgbd_cameras", name: "depth_stream" },
        { link_id: "rgbd_cameras", name: "stream_info" },
        { link_id: "rgbd_cameras", name: "geometry" },
      ],
      consumes: [
        { link_id: "arms", name: "joint_setpoints" },
        { link_id: "grippers", name: "gripper_setpoints" },
      ],
    },
  },
  execution: {
    language: "python",
    container: {
      def_file: "apptainer.def",
      // The image ships only the mesa EGL vendor, so without this hook
      // MUJOCO_GL=egl renders camera frames on whatever the host exposes
      // through /dev/dri: measured on one machine, the integrated GPU at
      // 24ms per capture cycle against the NVIDIA card's 3ms, and a software
      // rasterizer where there is no integrated GPU either. On a host with no
      // NVIDIA libraries at all (a Mac, where peppy runs apptainer inside a
      // Lima VM) the hook costs one "could not find any nv files" warning per
      // run and rendering falls back to the same path as before.
      apptainer_run_extra_args: ["--nv"],
    },
    parameters: {
      // Rate (Hz) of the measured-state streams (joint_states / gripper_states).
      // Where the deployment names this simulation its clock domain's
      // publisher, the same rate is how often that domain advances, so it
      // also sets how finely every instance bound to it can read time.
      state_rate_hz: "u32",
      // Run without a native viewer window (the deployment default). "Headless"
      // here means no local GUI window, not no viewer: this mode serves the
      // viser viewer to a browser on viewer_host:viewer_port, which is how the
      // sim is watched in a deployment and the only viewer that works inside a
      // container.
      //
      // Set false to open a native MuJoCo GLFW window instead. That mode
      // serves no viser viewer, so nothing is reachable over the network.
      // It also needs a display socket bound into the container and MUJOCO_GL
      // overridden off the apptainer.def default of egl. Neither applies on macOS, where peppy runs apptainer inside a Lima
      // VM with no display: keep headless true there and use the browser.
      headless: { $type: "bool", $default: true },
      // Viser viewer bind address + port, used when headless is true. All
      // interfaces by default so the viewer is reachable from other machines.
      viewer_host: { $type: "string", $default: "0.0.0.0" },
      viewer_port: { $type: "u32", $default: 8080 },
      // Render and stream the cameras of the standing robot's model on the
      // camera slots, each on the pair of its own relay. Required: the
      // launcher states whether cameras are rendered.
      cameras_enabled: "bool",
      // How long the standing robot may go without holding the pairs its
      // model asks for before it leaves the scene. A robot's pairs dissolve
      // when its nodes stop, so a robot whose process is gone leaves within
      // this window; the same window is how long a robot that has just
      // attached has to pair its limbs, and how long one paired as another
      // model stays before its stay ends naming both lists.
      robot_lease_ms: { $type: "u32", $default: 2000 },
    },
  },
}
