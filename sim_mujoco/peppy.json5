{
  peppy_schema: "node/v1",
  manifest: {
    name: "sim_mujoco",
    tag: "v1",
    description: [
      "The MuJoCo simulation: it stands any number of robots, of any model it has an entry for, in one composed scene, and serves a viser viewer to a browser. It needs no GPU, but it renders the robot cameras much faster on an NVIDIA GPU.",
      "Each robot joins by attaching over the simulation_robot contract, naming the copy it runs as, the model it is and where it stands; the engine composes its scene from the models standing in it and steps them for as long as they stay. The engine plays the follower role of every limb pairing and every base pairing of every robot: a robot's backbone leads each limb's pair, its base node leads its base's, and the simulation's measured state streams back on each. Whether a robot stands with a pair for every limb and the base of its model is its readiness, answered on the same contract.",
    ],
    implements: [
      // How a robot joins this scene: it attaches with the copy it runs as,
      // its model and the spot it stands on, and stays for as long as its
      // goal runs. A robot that asks for no spot takes a free one of the
      // engine's own. Whether it stands with every limb and its base paired
      // is its readiness.
      { name: "simulation_robot", tag: "v1", link_id: "robots" },
    ],
    depends_on: {
      pairings: [
        // The engine plays the follower role of every limb's pairing, one
        // slot per kind of limb, each holding any number of pairs: governed
        // setpoints stream in, the robot's measured state streams back on
        // the same pair. A pair's robot is the copy it carries and its limb
        // is the link it comes from on the robot's side (left_arm, arm), so
        // nothing on the wire carries an arm_id or a robot id, and a robot
        // of any model pairs here. A robot whose pairs are not the limbs, the
        // base and the cameras of its model does not stay.
        { name: "joint_link", tag: "v1", role: "follower", link_id: "arms", cardinality: "zero_or_more" },
        { name: "gripper_link", tag: "v1", role: "follower", link_id: "grippers", cardinality: "zero_or_more" },
        // A rolling robot's base: each wheel runs at the velocity its base
        // node streams for it, as the base's driver runs it in profile
        // velocity mode, and the measured wheel angles and rates stream back
        // on the same pair. A pair's base is the link it comes from on the
        // robot's side, `base`, the one name a robot answers to for its base.
        { name: "joint_link", tag: "v1", role: "follower", link_id: "bases", cardinality: "zero_or_more" },
        // Robot-mounted cameras rendered from the live scene, one slot per
        // kind of camera: the engine plays the camera role and a per-camera
        // relay presents the rgb/rgbd contract. A pair's camera is its
        // relay's name in the copy (wrist_left, wrist), and it is rendered
        // for the robot of its pair, so a stack that pairs no camera renders
        // none and pays for none.
        { name: "sim_rgb_camera_link", tag: "v1", role: "camera", link_id: "rgb_cameras", cardinality: "zero_or_more" },
        { name: "sim_rgbd_camera_link", tag: "v1", role: "camera", link_id: "rgbd_cameras", cardinality: "zero_or_more" },
      ],
    },
  },
  interfaces: {
    services: {
      exposes: [
        { link_id: "robots", name: "is_ready" },
      ],
    },
    actions: {
      exposes: [
        { link_id: "robots", name: "attach" },
      ],
    },
    topics: {
      emits: [
        { link_id: "arms", name: "joint_states" },
        { link_id: "grippers", name: "gripper_states" },
        { link_id: "bases", name: "joint_states" },
        { link_id: "rgb_cameras", name: "video_stream" },
        { link_id: "rgb_cameras", name: "stream_info" },
        { link_id: "rgb_cameras", name: "geometry" },
        { link_id: "rgbd_cameras", name: "video_stream" },
        { link_id: "rgbd_cameras", name: "depth_stream" },
        { link_id: "rgbd_cameras", name: "stream_info" },
        { link_id: "rgbd_cameras", name: "geometry" },
      ],
      consumes: [
        { link_id: "arms", name: "joint_setpoints" },
        { link_id: "grippers", name: "gripper_setpoints" },
        { link_id: "bases", name: "joint_setpoints" },
      ],
    },
  },
  execution: {
    language: "python",
    container: {
      def_file: "apptainer.def",
      // The image ships only the mesa EGL vendor, so without this hook
      // MUJOCO_GL=egl renders camera frames on whatever the host exposes
      // through /dev/dri: measured on one machine, the integrated GPU at
      // 24ms per capture cycle against the NVIDIA card's 3ms, and a software
      // rasterizer where there is no integrated GPU either. On a host with no
      // NVIDIA libraries at all (a Mac, where peppy runs apptainer inside a
      // Lima VM) the hook costs one "could not find any nv files" warning per
      // run and rendering falls back to the same path as before.
      apptainer_run_extra_args: ["--nv"],
    },
    // The socket the viewer binds during setup. The label is announced with
    // the address the viewer took; the daemon reports the URLs.
    endpoints: {
      viewer: { kind: "page", description: "The viser viewer of the scene, HTTP and WebSocket." },
    },
    parameters: {
      // Rate (Hz) of the measured-state streams (the arms' and the bases'
      // joint_states, gripper_states).
      // Where the deployment names this simulation its clock domain's
      // publisher, the same rate is how often that domain advances, so it
      // also sets how finely every instance bound to it can read time.
      state_rate_hz: "u32",
      // Where the viser viewer is served, which shows the scene whether or
      // not a robot stands in it. viewer_host is a literal IP address, not a
      // hostname: all interfaces by default, so the viewer is reachable from
      // other machines. viewer_port is the port the viewer prefers: an engine
      // whose port another process already holds serves on one the operating
      // system picks and logs the address it took, so two engines on a host
      // both come up.
      viewer_host: { $type: "string", $default: "0.0.0.0" },
      viewer_port: { $type: "u16", $default: 23818 },
      // Render and stream the cameras of the standing robot's model on the
      // camera slots, each on the pair of its own relay. Required: the
      // launcher states whether cameras are rendered.
      cameras_enabled: "bool",
      // The pair grace time: how long the standing robot may go without
      // holding the pairs its model asks for before it leaves the scene, once
      // a limb or its base first reached it. A robot's pairs dissolve when
      // its nodes stop, so a robot whose process is gone leaves within this
      // window, and one paired as another model stays this long before its
      // stay ends naming both lists; a robot no limb or base reached yet
      // stays for as long as its goal does.
      robot_pair_grace_ms: { $type: "u32", $default: 2000 },
    },
  },
}
