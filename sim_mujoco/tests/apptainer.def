Bootstrap: docker
From: peppybot/python-uv-base:latest

# The image CI runs this suite in (.github/scripts/ci_containers.py derives it
# from the From: line and the %post below). Not the node's own image: the
# suites render nothing and run on a stock interpreter.

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    # uv resolves sim_robot_core and robot_description_py as git
    # dependencies; the base image has no git. gcc and libc6-dev link
    # robot_description_py, a Rust extension that uv builds from its source.
    apt-get update -qq
    apt-get install -qqy --no-install-recommends git gcc libc6-dev
    rm -rf /var/lib/apt/lists/*
    # The Rust toolchain that builds robot_description_py: rustup's minimal
    # profile under /opt/rust, and the toolchain's own cargo and rustc on the
    # default PATH, where they run without rustup's environment, as CI runs
    # the suite with an environment and a HOME of its own.
    export RUSTUP_HOME=/opt/rust/rustup CARGO_HOME=/opt/rust/cargo
    curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs \
        | sh -s -- -y --no-modify-path --profile minimal --default-toolchain stable
    ln -s "$("$CARGO_HOME/bin/rustup" which cargo)" /usr/local/bin/cargo
    ln -s "$("$CARGO_HOME/bin/rustup" which rustc)" /usr/local/bin/rustc
