{
  peppy_schema: "node/v1",
  manifest: {
    name: "my_python_robot_backbone",
    tag: "v1",
    description: [
      "An example backbone that drives two example arms, left_robot_arm and right_robot_arm, behind one move_arm action. It opens no device: its arms are my_python_robot_arm nodes, which move in software only.",
      "A reference node, to read rather than to deploy. my_rust_robot_backbone is the same node in Rust.",
    ],
    labels: [
      "openarm01"
    ],
    depends_on: {
      nodes: [
        {
          name: "my_python_robot_arm",
          tag: "v1",
          link_id: "right_robot_arm"
        },
        {
          name: "my_python_robot_arm",
          tag: "v1",
          link_id: "left_robot_arm"
        }
      ]
    }
  },
  execution: {
    language: "python",
    build_cmd: [
      "uv",
      "sync",
      "--no-editable"
    ],
    run_cmd: [
      "./.venv/bin/python",
      "-m",
      "my_python_robot_backbone"
    ]
  },
  interfaces: {
    actions: {
      exposes: [
        {
          name: "move_arm",
          description: "Move the arm that arm_id selects to desired_position. The backbone sends the goal to that arm and relays the decision of the arm, its feedback (the position on the way) and its result (the final position). It refuses an unknown arm_id, and a goal for an arm that moves.",
          goal_service: {
            request_message_format: {
              arm_id: { $type: "u16", $description: "The arm to move: 0 for the left arm, 1 for the right arm." },
              desired_position: {
                $type: "array",
                $items: "i32",
                $length: 3,
                $description: "The target position, as x, y, z.",
              }
            }
          },
          feedback_topic: {
            qos_profile: "standard",
            message_format: {
              current_position: {
                $type: "array",
                $items: "i32",
                $length: 3
              }
            }
          },
          result_service: {
            response_message_format: {
              final_position: {
                $type: "array",
                $items: "i32",
                $length: 3
              }
            }
          }
        },
      ],
      consumes: [
        {
          link_id: "right_robot_arm",
          name: "move_arm",
        },
        {
          link_id: "left_robot_arm",
          name: "move_arm",
        },
      ],
    },
  }
}