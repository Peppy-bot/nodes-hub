{
  peppy_schema: "node/v1",
  manifest: {
    name: "deliberative_planner",
    tag: "v1",
    description: [
      "The slow half of an example manipulation stack that runs on two machines. It plans at about 1 Hz from the images of the robot camera (any rgb_camera:v1), so it can run away from the robot, for example on a server with an accelerator. It is the planner of a deliberation pairing with reactive_policy.",
      "A mock, to read rather than to deploy: it runs no inference and needs no model weights. It reads the situation that the executor reports and sends subgoals back. It has no access to an actuator.",
    ],
    depends_on: {
      // The same camera contract the policy consumes. Nothing here records
      // which machine the camera runs on: placement is declared once, on the
      // instance, and never repeated at the point of use.
      contracts: [
        { name: "rgb_camera", tag: "v1", link_id: "scene" }
      ],
      pairings: [
        { name: "deliberation", tag: "v1", role: "planner", link_id: "deliberation" }
      ]
    },
    labels: [
      "manipulation",
      "planner",
      "python"
    ]
  },
  execution: {
    language: "python",
    build_cmd: ["uv", "sync", "--no-editable"],
    run_cmd: ["./.venv/bin/python", "-m", "deliberative_planner"],
    parameters: {
      // Roughly 1 Hz. A WAN round trip is a small fraction of this node's own
      // cycle, which is exactly why it can sit in a datacenter.
      plan_rate_hz: { $type: "u16", $default: 1 },
      // How far ahead each subgoal is planned, published alongside it so the
      // executor can weigh it against its own staleness bound.
      horizon_s: { $type: "f64", $default: 30.0 }
    }
  },
  interfaces: {
    topics: {
      emits: [
        { link_id: "deliberation", name: "subgoal" }
      ],
      consumes: [
        { link_id: "scene", name: "video_stream" },
        { link_id: "deliberation", name: "situation" }
      ]
    }
  }
}
