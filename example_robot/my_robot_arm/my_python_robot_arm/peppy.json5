{
  peppy_schema: "node/v1",
  manifest: {
    name: "my_python_robot_arm",
    tag: "v1",
    description: [
      "An example arm with three joints that moves in software only. It opens no device, so it runs on any machine. It publishes its joint states and moves to a target position on a move_arm goal.",
      "A reference node, to read rather than to deploy. my_rust_robot_arm is the same node in Rust.",
    ],
    labels: [
      "arm",
      "openarm01",
      "python"
    ]
  },
  execution: {
    language: "python",
    build_cmd: [
      "uv",
      "sync",
      "--no-editable"
    ],
    run_cmd: [
      "./.venv/bin/python",
      "-m",
      "my_python_robot_arm"
    ]
  },
  interfaces: {
    topics: {
      emits: [
        {
          name: "joint_states",
          description: "The position and the velocity of each of the three joints, two times a second. The velocities are always 0.",
          qos_profile: "sensor_data",
          message_format: {
            positions: {
              $type: "array",
              $items: "f64",
              $length: 3
            },
            velocities: {
              $type: "array",
              $items: "f64",
              $length: 3
            },
            timestamp: "time"
          }
        }
      ],
    },
    actions: {
      exposes: [
        {
          name: "move_arm",
          description: "Move the arm to desired_position in 1 to 3 s. The feedback gives the position on the way, about every 200 ms. The result gives the final position, or the position at which a cancel stopped the arm. The arm refuses a goal while it moves.",
          goal_service: {
            request_message_format: {
              desired_position: {
                $type: "array",
                $items: "i32",
                $length: 3,
                $description: "The target position, as x, y, z.",
              }
            }
          },
          feedback_topic: {
            qos_profile: "standard",
            message_format: {
              current_position: {
                $type: "array",
                $items: "i32",
                $length: 3
              }
            }
          },
          result_service: {
            response_message_format: {
              final_position: {
                $type: "array",
                $items: "i32",
                $length: 3
              }
            }
          }
        }
      ]
    },
  }
}