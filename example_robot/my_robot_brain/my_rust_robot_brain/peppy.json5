{
  peppy_schema: "node/v1",
  manifest: {
    name: "my_rust_robot_brain",
    tag: "v1",
    description: [
      "An example brain that moves both arms of the example backbone from the images of a camera. It needs a camera that implements rgb_camera:v1 and a my_rust_robot_backbone. It opens no device itself.",
      "A reference node, to read rather than to deploy. It runs no model: it takes the first three bytes of the newest frame as a target position and sends that position to both arms. my_python_robot_brain is the same node in Python.",
    ],
    labels: [
      "brain"
    ],
    depends_on: {
      contracts: [
        {
          name: "rgb_camera",
          tag: "v1",
          link_id: "camera"
        }
      ],
      nodes: [
        {
          name: "my_rust_robot_backbone",
          tag: "v1",
          link_id: "robot_controller"
        }
      ]
    }
  },
  execution: {
    language: "rust",
    build_cmd: [
      "cargo",
      "build",
      "--release"
    ],
    run_cmd: [
      "./target/release/my_rust_robot_brain"
    ]
  },
  interfaces: {
    topics: {
      // The brain receives the inputs from the camera
      consumes: [
        {
          link_id: "camera",
          name: "video_stream",
        },
      ],
    },
    services: {
      consumes: [
        {
          link_id: "camera",
          name: "video_stream_info",
        },
      ]
    },
    actions: {
      consumes: [
        {
          link_id: "robot_controller",
          name: "move_arm"
        }
      ]
    }
  }
}