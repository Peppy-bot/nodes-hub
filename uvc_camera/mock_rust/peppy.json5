{
  peppy_schema: "node/v1",
  manifest: {
    name: "uvc_camera_rust_mock",
    tag: "v1",
    description: [
      "A camera with no hardware, in Rust: it replays a bundled video file as the video_stream of rgb_camera and acknowledges every camera control. It opens no device, so it runs on any machine.",
      "Use it to bring a consumer up without a camera or a simulation. It is not a simulation: the footage has no relationship to the pose of any robot. The controls echo the value they get and check nothing, so do not use it to test control semantics. uvc_camera_python_mock is the same node in Python.",
    ],
    implements: [
      { name: "rgb_camera", tag: "v1", link_id: "camera" },
    ],
    labels: [
      "uvc",
      "camera"
    ]
  },
  execution: {
    language: "rust",
    container: {
      def_file: "apptainer.def"
    },
    // Those are fake parameters supposed to emulate a real camera
    parameters: {
      device_path: {
        $type: "string",
        $default: "/dev/video0"
      },
      video: {
        frame_rate: {
          $type: "u16",
          $default: 30
        },
        resolution: {
          width: {
            $type: "u16",
            $default: 1920
          },
          height: {
            $type: "u16",
            $default: 1080
          },
        },
        camera_encoding: {
          $type: "string",
          $default: "mjpeg"
        },
        topic_encoding: {
          $type: "string",
          $default: "rgb8"
        },
      },
    },
  },
  interfaces: {
    topics: {
      emits: [
        { link_id: "camera", name: "video_stream" },
      ],
    },
    services: {
      exposes: [
        { link_id: "camera", name: "video_stream_info" },
        { link_id: "camera", name: "set_exposure" },
        { link_id: "camera", name: "set_white_balance" },
        { link_id: "camera", name: "set_gain" },
        { link_id: "camera", name: "set_brightness" },
        { link_id: "camera", name: "set_contrast" },
      ],
    },
  }
}
