{
  peppy_schema: "node/v1",
  manifest: {
    name: "uvc_camera_rust_mock",
    tag: "v1",
    description: [
      "A camera with no hardware, in Rust: it replays a bundled video file as the video_stream of rgb_camera and acknowledges every camera control. It opens no device, so it runs on any machine.",
      "Each picture names in its header's frame the camera's frame, read once at its start: with the sensor_mounts link bound to the robot that carries the camera, whose robot_identity implementer serves it, the frame that sensor_mounts' describe_sensors gives for the name the camera runs under; with the link vacant, for a camera that no robot carries, that name, a frame no robot's tree holds.",
      "Use it to bring a consumer up without a camera or a simulation. It is not a simulation: the footage has no relationship to the pose of any robot. The controls echo the value they get and check nothing, so do not use it to test control semantics. uvc_camera_python_mock is the same node in Python.",
    ],
    implements: [
      { name: "rgb_camera", tag: "v1", link_id: "camera" },
    ],
    depends_on: {
      contracts: [
        // The robot that carries this camera, whose robot_identity implementer
        // serves sensor_mounts: describe_sensors gives the frame the camera
        // names in each picture, read once at its start by the name it runs
        // under. Vacant for a camera that no robot carries, whose pictures
        // name the name it runs under.
        { name: "sensor_mounts", tag: "v1", link_id: "sensor_mounts", cardinality: "zero_or_one" },
      ],
    },
    labels: [
      "uvc",
      "camera"
    ]
  },
  execution: {
    language: "rust",
    container: {
      def_file: "apptainer.def"
    },
    // Those are fake parameters supposed to emulate a real camera
    parameters: {
      device_path: {
        $type: "string",
        $default: "/dev/video0"
      },
      video: {
        frame_rate: {
          $type: "u16",
          $default: 30
        },
        resolution: {
          width: {
            $type: "u16",
            $default: 1920
          },
          height: {
            $type: "u16",
            $default: 1080
          },
        },
        camera_encoding: {
          $type: "string",
          $default: "mjpeg"
        },
        topic_encoding: {
          $type: "string",
          $default: "rgb8"
        },
      },
    },
  },
  interfaces: {
    topics: {
      emits: [
        { link_id: "camera", name: "video_stream" },
      ],
    },
    services: {
      exposes: [
        { link_id: "camera", name: "video_stream_info" },
        { link_id: "camera", name: "set_exposure" },
        { link_id: "camera", name: "set_white_balance" },
        { link_id: "camera", name: "set_gain" },
        { link_id: "camera", name: "set_brightness" },
        { link_id: "camera", name: "set_contrast" },
      ],
      consumes: [
        { link_id: "sensor_mounts", name: "describe_sensors" },
      ],
    },
  }
}
