Bootstrap: docker
From: tuatini/peppy-python-uv-base:latest

%labels
    Name uvc_camera_python_mock
    Version 0.1.0

%environment
    export PATH="/opt/uvc_camera_python_mock/.venv/bin:$PATH"

%files
    . /opt/uvc_camera_python_mock

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    # Keep the interpreter inside the image. uv installs managed Pythons under
    # $HOME by default, and apptainer bind-mounts a home over that path while
    # building, so the interpreter lands on the host rather than in the SIF and
    # the venv's `python` is a symlink out of the image. That survives only as
    # long as the same home is mounted at the same path at run time; anywhere
    # it is not, the node builds perfectly and then dies at exec with
    # `./.venv/bin/python: not found`.
    export UV_PYTHON_INSTALL_DIR=/opt/uv-python

    cd /opt/uvc_camera_python_mock
    uv python install
    uv sync --no-editable

%runscript
    cd /opt/uvc_camera_python_mock
    exec ./.venv/bin/python -m uvc_camera_python_mock
