{
  peppy_schema: "node/v1",
  manifest: {
    name: "uvc_camera_linux",
    tag: "v1",
    implements: [
      { name: "rgb_camera", tag: "v1", link_id: "camera" },
      // A UVC device carries no calibration, so every member refuses and
      // says why. It is implemented so a consumer of a wrist camera meets
      // the same surface on hardware as in simulation; the intrinsics
      // arrive with calibration-file loading, a change of its own.
      { name: "camera_geometry", tag: "v1", link_id: "geometry" },
    ],
    labels: [
      "uvc",
      "camera",
      "usb",
    ]
  },
  execution: {
    language: "rust",
    container: {
      def_file: "apptainer.def",
    },
    parameters: {
      device_path: "string",
      video: {
        frame_rate: "u16",
        resolution: {
          width: "u32",
          height: "u32",
        },
        camera_encoding: "string",
        topic_encoding: "string",
      },
    },
  },
  interfaces: {
    topics: {
      emits: [
        { link_id: "camera", name: "video_stream" },
      ],
    },
    services: {
      exposes: [
        { link_id: "camera", name: "video_stream_info" },
        { link_id: "camera", name: "set_exposure" },
        { link_id: "camera", name: "set_white_balance" },
        { link_id: "camera", name: "set_gain" },
        { link_id: "camera", name: "set_brightness" },
        { link_id: "camera", name: "set_contrast" },
        { link_id: "geometry", name: "get_color_intrinsics" },
        { link_id: "geometry", name: "get_depth_intrinsics" },
        { link_id: "geometry", name: "get_depth_to_color_extrinsics" },
      ],
    },
  }
}
