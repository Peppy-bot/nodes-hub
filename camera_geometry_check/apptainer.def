Bootstrap: docker
From: peppybot/rust-cargo-base:latest

%labels
    Name camera_geometry_check
    Version v1

%files
    . /opt/camera_geometry_check

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    cd /opt/camera_geometry_check
    cargo build --release

%runscript
    cd /opt/camera_geometry_check
    exec ./target/release/camera_geometry_check "$@"
