{
  peppy_schema: "node/v1",

  manifest: {
    name: "scene_commander",
    tag: "v1",

    labels: [
      "simulation",
      "scene",
      "commander",
      "web",
    ],

    depends_on: {
      // The scene editing surface of whichever simulation the launcher
      // binds here, and the object state of that same simulation, which
      // the panel reads on demand to list what is spawned.
      contracts: [
        { name: "scene_control", tag: "v1", link_id: "simulation" },
        { name: "object_state", tag: "v1", link_id: "objects" },
      ],
    },
  },

  interfaces: {
    services: {
      consumes: [
        {
          link_id: "simulation",
          name: "get_assets_list",
        },
        {
          link_id: "objects",
          name: "get_object_states",
        },
      ],
    },

    actions: {
      consumes: [
        {
          link_id: "simulation",
          name: "load_scene",
        },
        {
          link_id: "simulation",
          name: "clear_scene",
        },
        {
          link_id: "simulation",
          name: "spawn_object",
        },
        {
          link_id: "simulation",
          name: "move_object",
        },
        {
          link_id: "simulation",
          name: "remove_object",
        },
        {
          link_id: "simulation",
          name: "apply_force",
        },

        {
          link_id: "simulation",
          name: "move_robot",
        },
      ],
    },
  },

  execution: {
    language: "python",

    container: {
      def_file: "apptainer.def",
    },

    parameters: {
      // Where the scene panel is served. http_host is a literal IP address,
      // not a hostname. http_port is the port the panel prefers: a copy whose
      // port another process already holds serves on one the operating system
      // picks and logs the address it took, so two copies on a host both come
      // up.
      http_host: {
        $type: "string",
        $default: "0.0.0.0",
      },

      http_port: {
        $type: "u16",
        $default: 8766,
      },
    },
  },
}
