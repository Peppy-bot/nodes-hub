{
  peppy_schema: "node/v1",

  manifest: {
    name: "scene_commander",
    tag: "v1",

    labels: [
      "simulation",
      "scene",
      "commander",
      "web",
    ],

    depends_on: {
      // The scene editing surface of whichever simulation the launcher
      // binds here, and the object state of that same simulation, which
      // the panel reads on demand to list what is spawned. The rest are
      // capabilities a launch may leave vacant: the panel shows a lighting
      // panel, a materials panel and a camera panel only for the
      // capabilities that are bound, and lists in the camera panel the
      // cameras whose relays are linked here, matching each camera to its
      // profile by the instance that serves both.
      contracts: [
        { name: "scene_manipulation", tag: "v1", link_id: "simulation" },
        { name: "object_state", tag: "v1", link_id: "objects" },
        { name: "scene_lighting", tag: "v1", link_id: "lighting", cardinality: "zero_or_one" },
        { name: "scene_materials", tag: "v1", link_id: "materials", cardinality: "zero_or_one" },
        { name: "rgb_camera", tag: "v1", link_id: "color_cameras", cardinality: "zero_or_more" },
        { name: "rgbd_camera", tag: "v1", link_id: "rgbd_cameras", cardinality: "zero_or_more" },
        { name: "camera_profile", tag: "v1", link_id: "camera_profiles", cardinality: "zero_or_more" },
      ],
    },
  },

  interfaces: {
    services: {
      consumes: [
        {
          link_id: "simulation",
          name: "get_assets_list",
        },
        {
          link_id: "objects",
          name: "get_object_states",
        },
        {
          link_id: "simulation",
          name: "get_robots_list",
        },
        { link_id: "lighting", name: "get_lighting" },
        { link_id: "lighting", name: "set_light_intensity" },
        { link_id: "lighting", name: "set_light_color" },
        { link_id: "lighting", name: "set_light_position" },
        { link_id: "lighting", name: "set_light_direction" },
        { link_id: "lighting", name: "set_light_cone" },
        { link_id: "lighting", name: "set_light_orientation" },
        { link_id: "lighting", name: "reset_lighting" },
        { link_id: "materials", name: "get_materials" },
        { link_id: "materials", name: "set_material_color" },
        { link_id: "materials", name: "set_material_finish" },
        { link_id: "materials", name: "reset_materials" },
        { link_id: "color_cameras", name: "video_stream_info" },
        { link_id: "color_cameras", name: "set_exposure" },
        { link_id: "color_cameras", name: "set_white_balance" },
        { link_id: "color_cameras", name: "set_gain" },
        { link_id: "color_cameras", name: "set_brightness" },
        { link_id: "color_cameras", name: "set_contrast" },
        { link_id: "rgbd_cameras", name: "video_stream_info" },
        { link_id: "rgbd_cameras", name: "set_color_exposure" },
        { link_id: "rgbd_cameras", name: "set_color_white_balance" },
        { link_id: "rgbd_cameras", name: "set_color_gain" },
        { link_id: "rgbd_cameras", name: "set_color_brightness" },
        { link_id: "rgbd_cameras", name: "set_color_contrast" },
        { link_id: "camera_profiles", name: "get_camera_profile" },
        { link_id: "camera_profiles", name: "reset_camera" },
      ],
    },

    actions: {
      consumes: [
        {
          link_id: "simulation",
          name: "load_scene",
        },
        {
          link_id: "simulation",
          name: "clear_scene",
        },
        {
          link_id: "simulation",
          name: "spawn_object",
        },
        {
          link_id: "simulation",
          name: "move_object",
        },
        {
          link_id: "simulation",
          name: "remove_object",
        },
        {
          link_id: "simulation",
          name: "apply_force",
        },

        {
          link_id: "simulation",
          name: "move_robot",
        },
      ],
    },
  },

  execution: {
    language: "python",

    container: {
      def_file: "apptainer.def",
    },

    parameters: {
      // Where the scene panel is served. http_host is a literal IP address,
      // not a hostname. http_port is the port the panel prefers: a copy whose
      // port another process already holds serves on one the operating system
      // picks and logs the address it took, so two copies on a host both come
      // up.
      http_host: {
        $type: "string",
        $default: "0.0.0.0",
      },

      http_port: {
        $type: "u16",
        $default: 8766,
      },
    },
  },
}
