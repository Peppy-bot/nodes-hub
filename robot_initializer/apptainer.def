Bootstrap: docker
From: peppybot/rust-cargo-base:latest

%labels
    Name robot_initializer
    Version v1

%files
    . /opt/robot_initializer

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    cd /opt/robot_initializer
    cargo build --release

%runscript
    cd /opt/robot_initializer
    exec ./target/release/robot_initializer
